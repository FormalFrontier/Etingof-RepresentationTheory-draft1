@[simp] private lemma intTensorOverEquiv_mk (N : Type) [AddCommGroup N]
    (m : ℤ) (n : N) :
    intTensorOverEquiv N (TensorProduct.tmul ℤ m n : RepresentationTheory.Algebra.Homology.TensorProductConstruction.ModuleConstruction ℤ N ℤ) = m • n := by
  simp only [intTensorOverEquiv, AddEquiv.trans_apply, LinearEquiv.coe_toAddEquiv]
  rfl

