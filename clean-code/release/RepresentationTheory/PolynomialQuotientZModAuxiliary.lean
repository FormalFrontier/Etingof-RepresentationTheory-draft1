/-- The degree-one auxiliary categorical object of a cyclic module with nonzero modulus is isomorphic to a natural scalar-map kernel. -/
theorem auxiliaryIntZModDegreeOneKerIso (a : ℕ) (ha : a ≠ 0) (N : Type) [AddCommGroup N] :
    Nonempty (RepresentationTheory.Algebra.Homology.TensorProductConstruction.degreewiseModuleGroup ℤ N (ModuleCat.of ℤᵐᵒᵖ (ZMod a)) 1
      ≅ AddCommGrpCat.of (LinearMap.ker (natScalarLinearMap a N))) := by
  haveI : NeZero a := ⟨ha⟩
  have ha' : (a : ℤ) ≠ 0 := by exact_mod_cast ha

  let f : ℤ →ₗ[ℤᵐᵒᵖ] ℤ :=
    { toFun := fun x => (a : ℤ) * x
      map_add' := fun x y => by ring
      map_smul' := fun r x => by
        simp only [RingHom.id_apply, MulOpposite.smul_eq_mul_unop]; ring }
  let g : ℤ →ₗ[ℤᵐᵒᵖ] ZMod a :=
    { toFun := fun x => (x : ZMod a)
      map_add' := fun x y => by push_cast; ring
      map_smul' := fun r x => by
        have hsmul : (r • (x : ZMod a)) = MulOpposite.unop r • (x : ZMod a) := rfl
        simp only [RingHom.id_apply, MulOpposite.smul_eq_mul_unop, hsmul, zsmul_eq_mul]
        push_cast; ring }
  have hgf : ∀ x : ℤ, g (f x) = 0 := by
    intro x
    change (((a : ℤ) * x : ℤ) : ZMod a) = 0
    rw [ZMod.intCast_zmod_eq_zero_iff_dvd]; exact dvd_mul_right _ _
  have eq0 : g.comp f = 0 :=
    LinearMap.ext fun x => by rw [LinearMap.comp_apply, hgf x, LinearMap.zero_apply]
  have hexact : Function.Exact f g := by
    rw [LinearMap.exact_iff]; ext y
    simp only [LinearMap.mem_ker, LinearMap.mem_range]
    change (((y : ℤ) : ZMod a) = 0) ↔ _
    rw [ZMod.intCast_zmod_eq_zero_iff_dvd]
    constructor
    · rintro ⟨c, rfl⟩; exact ⟨c, rfl⟩
    · rintro ⟨c, rfl⟩; exact dvd_mul_right _ _
  have hinjf : Function.Injective f := fun x y hxy =>
    mul_left_cancel₀ ha' (by simpa only [f, LinearMap.coe_mk, AddHom.coe_mk] using hxy)
  have hsurjg : Function.Surjective g := by
    intro z; obtain ⟨y, rfl⟩ := ZMod.intCast_surjective z; exact ⟨y, rfl⟩
  set S := ModuleCat.shortComplexOfCompEqZero f g eq0 with hSdef
  have hS : S.ShortExact := ModuleCat.shortComplex_shortExact S hexact hinjf hsurjg
  set F := RepresentationTheory.Algebra.Homology.TensorProductConstruction.moduleConstructionFunctor ℤ N with hF

  obtain ⟨δ, hExact⟩ := RepresentationTheory.CategoryPair.AssociatedType.exists_connectingMorphism_exact F hS 0 1 rfl
  let φ : (F.leftDerived 0).obj S.X₁ ⟶ (F.leftDerived 0).obj S.X₂ := (F.leftDerived 0).map S.f

  have h1 : Limits.IsZero ((F.leftDerived 1).obj S.X₂) :=
    Functor.isZero_leftDerived_obj_projective_succ F 0 S.X₂
  have hmono : Mono δ := by
    have e123 := hExact.exact' 1 2 3
    rwa [ShortComplex.exact_iff_mono _ (h1.eq_zero_of_src _)] at e123
  have hinjδ : Function.Injective δ.hom := (AddCommGrpCat.mono_iff_injective δ).mp hmono

  have hrk : δ.hom.range = φ.hom.ker := (hExact.exact' 2 3 4).ab_range_eq_ker
  have hcompl : δ ≫ φ = 0 := hExact.toIsComplex.zero' 2 3 4

  let ζ := F.leftDerivedZeroIsoSelf
  let τ₁ : ((F.leftDerived 0).obj S.X₁) ≃+ N :=
    (ζ.app S.X₁).addCommGroupIsoToAddEquiv.trans (intTensorOverEquiv N)
  let τ₂ : ((F.leftDerived 0).obj S.X₂) ≃+ N :=
    (ζ.app S.X₂).addCommGroupIsoToAddEquiv.trans (intTensorOverEquiv N)

  have key : ∀ w : RepresentationTheory.Algebra.Homology.TensorProductConstruction.ModuleConstruction ℤ N S.X₁,
      intTensorOverEquiv N (RepresentationTheory.Algebra.Homology.TensorProductConstruction.moduleConstructionMap ℤ N S.f w)
        = natScalarLinearMap a N (intTensorOverEquiv N w) := by
    intro w
    induction w using QuotientAddGroup.induction_on with
    | _ y =>
      induction y using TensorProduct.induction_on with
      | zero => simp
      | tmul m n =>
        change intTensorOverEquiv N
            (RepresentationTheory.Algebra.Homology.TensorProductConstruction.moduleConstructionMap ℤ N S.f (TensorProduct.tmul ℤ m n : RepresentationTheory.Algebra.Homology.TensorProductConstruction.ModuleConstruction ℤ N S.X₁))
          = natScalarLinearMap a N
            (intTensorOverEquiv N (TensorProduct.tmul ℤ m n : RepresentationTheory.Algebra.Homology.TensorProductConstruction.ModuleConstruction ℤ N S.X₁))
        rw [show RepresentationTheory.Algebra.Homology.TensorProductConstruction.moduleConstructionMap ℤ N S.f
              (TensorProduct.tmul ℤ m n : RepresentationTheory.Algebra.Homology.TensorProductConstruction.ModuleConstruction ℤ N S.X₁)
            = (TensorProduct.tmul ℤ (S.f.hom m) n : RepresentationTheory.Algebra.Homology.TensorProductConstruction.ModuleConstruction ℤ N S.X₂) from rfl,
          intTensorOverEquiv_mk, intTensorOverEquiv_mk, natScalarLinearMap_apply, smul_smul]
        rfl
      | add p q hp hq =>
        rw [show ((p + q : TensorProduct ℤ S.X₁ N) : RepresentationTheory.Algebra.Homology.TensorProductConstruction.ModuleConstruction ℤ N S.X₁)
              = ((p : RepresentationTheory.Algebra.Homology.TensorProductConstruction.ModuleConstruction ℤ N S.X₁) + (q : RepresentationTheory.Algebra.Homology.TensorProductConstruction.ModuleConstruction ℤ N S.X₁))
            from map_add (QuotientAddGroup.mk' _) p q,
          map_add, map_add, map_add, map_add, hp, hq]
  have hconj : ∀ x, τ₂ (φ.hom x) = natScalarLinearMap a N (τ₁ x) := by
    intro x
    have hn := congrArg (fun (m : (F.leftDerived 0).obj S.X₁ ⟶ F.obj S.X₂) => m.hom x)
      (ζ.hom.naturality S.f)
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] at hn
    simp only [τ₁, τ₂, AddEquiv.trans_apply, Iso.addCommGroupIsoToAddEquiv_apply]
    calc intTensorOverEquiv N ((ζ.app S.X₂).hom (φ.hom x))
        = intTensorOverEquiv N
            (RepresentationTheory.Algebra.Homology.TensorProductConstruction.moduleConstructionMap ℤ N S.f ((ζ.app S.X₁).hom x)) :=
          congrArg (intTensorOverEquiv N) hn
      _ = natScalarLinearMap a N (intTensorOverEquiv N ((ζ.app S.X₁).hom x)) :=
          key _

  have mem : ∀ x, τ₁ (δ.hom x) ∈ LinearMap.ker (natScalarLinearMap a N) := by
    intro x
    rw [LinearMap.mem_ker, ← hconj (δ.hom x)]
    have : φ.hom (δ.hom x) = 0 := by
      have := congrArg
        (fun (m : (F.leftDerived 1).obj S.X₃ ⟶ (F.leftDerived 0).obj S.X₂) => m.hom x) hcompl
      simpa only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, AddCommGrpCat.hom_zero,
        AddMonoidHom.zero_apply] using this
    rw [this, map_zero]
  let κ : ((F.leftDerived 1).obj S.X₃) →+ LinearMap.ker (natScalarLinearMap a N) :=
    { toFun := fun x => ⟨τ₁ (δ.hom x), mem x⟩
      map_zero' := by apply Subtype.ext; simp
      map_add' := fun x y => by apply Subtype.ext; simp }
  have hκbij : Function.Bijective κ := by
    constructor
    · intro x y hxy
      apply hinjδ
      apply τ₁.injective
      exact congrArg Subtype.val hxy
    · rintro ⟨z, hz⟩
      have hwker : (τ₁.symm z) ∈ φ.hom.ker := by
        rw [AddMonoidHom.mem_ker]
        apply τ₂.injective
        rw [hconj, map_zero, τ₁.apply_symm_apply]
        exact (LinearMap.mem_ker.mp hz)
      rw [← hrk] at hwker
      obtain ⟨x, hx⟩ := hwker
      exact ⟨x, Subtype.ext (by rw [show ((κ x : _) : N) = τ₁ (δ.hom x) from rfl, hx,
        τ₁.apply_symm_apply])⟩
  exact ⟨(AddEquiv.ofBijective κ hκbij).toAddCommGrpIso⟩

/-- The degree-one auxiliary categorical object of two cyclic modules with nonzero moduli is isomorphic to the gcd cyclic module. -/
theorem auxiliaryZModDegreeOneGcdIso (a b : ℕ) (ha : a ≠ 0) (hb : b ≠ 0) :
    Nonempty (RepresentationTheory.Algebra.Homology.TensorProductConstruction.degreewiseModuleGroup ℤ (ZMod b) (ModuleCat.of ℤᵐᵒᵖ (ZMod a)) 1
      ≅ AddCommGrpCat.of (ZMod (Nat.gcd a b))) := by
  haveI : NeZero b := ⟨hb⟩
  obtain ⟨e⟩ := auxiliaryIntZModDegreeOneKerIso a ha (ZMod b)
  exact ⟨e ≪≫ (kerZModNatScalarLinearEquivGcd a b).toAddEquiv.toAddCommGrpIso⟩

/-- The degree-one auxiliary categorical object associated with a cyclic module of nonzero modulus is zero. -/
theorem auxiliaryZModDegreeOneIsZero (a : ℕ) (ha : a ≠ 0) :
    Limits.IsZero (RepresentationTheory.Algebra.Homology.TensorProductConstruction.degreewiseModuleGroup ℤ ℤ (ModuleCat.of ℤᵐᵒᵖ (ZMod a)) 1) := by
  haveI : NeZero a := ⟨ha⟩
  haveI := subsingleton_ker_natScalarLinearMapInt a
  obtain ⟨e⟩ := auxiliaryIntZModDegreeOneKerIso a ha ℤ
  exact (AddCommGrpCat.isZero_of_subsingleton _).of_iso e

private noncomputable def zmodMopResolution (a : ℕ) (ha : a ≠ 0) :
    {S : ShortComplex (ModuleCat.{0} ℤᵐᵒᵖ) //
      S.ShortExact ∧ S.X₁ = ModuleCat.of ℤᵐᵒᵖ ℤ ∧ S.X₂ = ModuleCat.of ℤᵐᵒᵖ ℤ ∧
      S.X₃ = ModuleCat.of ℤᵐᵒᵖ (ZMod a)} :=
  have ha' : (a : ℤ) ≠ 0 := by exact_mod_cast ha
  let f : ℤ →ₗ[ℤᵐᵒᵖ] ℤ :=
    { toFun := fun x => (a : ℤ) * x
      map_add' := fun x y => by ring
      map_smul' := fun r x => by
        simp only [RingHom.id_apply, MulOpposite.smul_eq_mul_unop]; ring }
  let g : ℤ →ₗ[ℤᵐᵒᵖ] ZMod a :=
    { toFun := fun x => (x : ZMod a)
      map_add' := fun x y => by push_cast; ring
      map_smul' := fun r x => by
        have hsmul : (r • (x : ZMod a)) = MulOpposite.unop r • (x : ZMod a) := rfl
        simp only [RingHom.id_apply, MulOpposite.smul_eq_mul_unop, hsmul, zsmul_eq_mul]
        push_cast; ring }
  have hf : ∀ x : ℤ, f x = (a : ℤ) * x := fun _ => rfl
  have hg : ∀ x : ℤ, g x = ((x : ℤ) : ZMod a) := fun _ => rfl
  have hgf : ∀ x : ℤ, g (f x) = 0 := by
    intro x; rw [hf, hg, ZMod.intCast_zmod_eq_zero_iff_dvd]; exact dvd_mul_right _ _
  have eq0 : g.comp f = 0 :=
    LinearMap.ext fun x => by rw [LinearMap.comp_apply, hgf x, LinearMap.zero_apply]
  let S := ModuleCat.shortComplexOfCompEqZero f g eq0
  have hexact : Function.Exact f g := by
    rw [LinearMap.exact_iff]; ext y
    simp only [LinearMap.mem_ker, hg, ZMod.intCast_zmod_eq_zero_iff_dvd, LinearMap.mem_range, hf]
    constructor
    · rintro ⟨c, rfl⟩; exact ⟨c, rfl⟩
    · rintro ⟨c, rfl⟩; exact dvd_mul_right _ _
  have hinj : Function.Injective f := fun x y hxy => mul_left_cancel₀ ha' (by rw [← hf, ← hf, hxy])
  have hsurj : Function.Surjective g := by
    intro z; obtain ⟨y, rfl⟩ := ZMod.intCast_surjective z; exact ⟨y, hg y⟩
  ⟨S, ModuleCat.shortComplex_shortExact S hexact hinj hsurj, rfl, rfl, rfl⟩

private noncomputable def zmodZeroOpEquiv : ℤ ≃ₗ[ℤᵐᵒᵖ] (ZMod 0) :=
  { (AddEquiv.refl ℤ) with
    map_smul' := fun r x => by
      rw [MulOpposite.smul_eq_mul_unop]
      change x * MulOpposite.unop r = MulOpposite.unop r • x
      rw [smul_eq_mul, mul_comm] }

open Limits in

/-- The auxiliary categorical object from a cyclic integer module and an additive group vanishes from degree two onward. -/
theorem auxiliaryIntZModModuleDegreeSuccSuccIsZero (a : ℕ) (N : Type) [AddCommGroup N] (n : ℕ) :
    Limits.IsZero (RepresentationTheory.Algebra.Homology.TensorProductConstruction.degreewiseModuleGroup ℤ N (ModuleCat.of ℤᵐᵒᵖ (ZMod a)) (n + 2)) := by
  rcases eq_or_ne a 0 with rfl | ha
  ·
    have hz := Functor.isZero_leftDerived_obj_projective_succ
      (RepresentationTheory.Algebra.Homology.TensorProductConstruction.moduleConstructionFunctor ℤ N) (n + 1) (ModuleCat.of ℤᵐᵒᵖ ℤ)
    exact hz.of_iso
      (((RepresentationTheory.Algebra.Homology.TensorProductConstruction.moduleConstructionFunctor ℤ N).leftDerived (n + 2)).mapIso
        zmodZeroOpEquiv.symm.toModuleIso)
  · obtain ⟨S, hS, hX₁, hX₂, hX₃⟩ := zmodMopResolution a ha
    set F := RepresentationTheory.Algebra.Homology.TensorProductConstruction.moduleConstructionFunctor ℤ N with hF
    obtain ⟨δ, hExact⟩ := RepresentationTheory.CategoryPair.AssociatedType.exists_connectingMorphism_exact F hS (n + 1) (n + 2) rfl
    have h1 : IsZero ((F.leftDerived (n + 2)).obj S.X₂) := by
      rw [hX₂]; exact Functor.isZero_leftDerived_obj_projective_succ F (n + 1) _
    have h3 : IsZero ((F.leftDerived (n + 1)).obj S.X₁) := by
      rw [hX₁]; exact Functor.isZero_leftDerived_obj_projective_succ F n _
    have hgoal : IsZero ((F.leftDerived (n + 2)).obj S.X₃) :=
      isZero_obj_two_of_sixTerm_exact hExact h1 h3
    rw [hX₃] at hgoal
    exact hgoal

/-- The auxiliary categorical object of two cyclic modules vanishes in degrees at least two. -/
theorem auxiliaryZModDegreeSuccSuccIsZero (a b : ℕ) (n : ℕ) :
    Limits.IsZero (RepresentationTheory.Algebra.Homology.TensorProductConstruction.degreewiseModuleGroup ℤ (ZMod b) (ModuleCat.of ℤᵐᵒᵖ (ZMod a)) (n + 2)) :=
  auxiliaryIntZModModuleDegreeSuccSuccIsZero a (ZMod b) n

/-- The positive-degree auxiliary categorical object with an integer input is zero. -/
theorem auxiliaryIntModuleDegreeSuccIsZero (N : Type) [AddCommGroup N] [Module ℤ N] (n : ℕ) :
    Limits.IsZero (RepresentationTheory.Algebra.Homology.TensorProductConstruction.degreewiseModuleGroup ℤ N (ModuleCat.of ℤᵐᵒᵖ ℤ) (n + 1)) :=
  Functor.isZero_leftDerived_obj_projective_succ (RepresentationTheory.Algebra.Homology.TensorProductConstruction.moduleConstructionFunctor ℤ N) n
    (ModuleCat.of ℤᵐᵒᵖ ℤ)

/-- In degree zero, the auxiliary integer construction on cyclic modules is additively equivalent to the gcd cyclic module. -/
theorem auxiliaryIntZModDegreeZeroGcdAddEquiv (a b : ℕ) (ha : a ≠ 0) (hb : b ≠ 0) :
    Nonempty (RepresentationTheory.CategoryTheory.Abelian.ExtensionClasses.CategoryTheory.ExtensionClasses (ModuleCat.of ℤ (ZMod a)) (ModuleCat.of ℤ (ZMod b)) 0
      ≃+ ZMod (Nat.gcd a b)) := by
  haveI : NeZero a := ⟨ha⟩
  haveI : NeZero b := ⟨hb⟩

  obtain ⟨e₀⟩ := RepresentationTheory.DerivedFunctorExactness.AuxiliaryDegreeZeroAddEquiv ℤ (ModuleCat.of ℤ (ZMod a)) (ModuleCat.of ℤ (ZMod b))
  exact ⟨e₀.trans (ModuleCat.homAddEquiv.trans (linearMapZModAddEquivGcd a b))⟩

/-- The degree-one auxiliary construction from a cyclic module with nonzero modulus is additively equivalent to the target modulo its generated scalar submodule. -/
theorem auxiliaryIntZModDegreeOneQuotientAddEquiv (a : ℕ) (ha : a ≠ 0) (Y : Type) [AddCommGroup Y] :
    Nonempty (RepresentationTheory.CategoryTheory.Abelian.ExtensionClasses.CategoryTheory.ExtensionClasses (ModuleCat.of ℤ (ZMod a)) (ModuleCat.of ℤ Y) 1
      ≃+ (Y ⧸ Ideal.span {(a : ℤ)} • (⊤ : Submodule ℤ Y))) := by
  haveI : NeZero a := ⟨ha⟩
  have ha' : (a : ℤ) ≠ 0 := by exact_mod_cast ha

  let f : ℤ →ₗ[ℤ] ℤ := (a : ℤ) • LinearMap.id
  let g : ℤ →ₗ[ℤ] ZMod a := Algebra.linearMap ℤ (ZMod a)
  have hf : ∀ x : ℤ, f x = (a : ℤ) * x := fun x => by simp [f]
  have hg : ∀ x : ℤ, g x = ((x : ℤ) : ZMod a) := fun x => by
    simp [g, Algebra.linearMap_apply, algebraMap_int_eq, eq_intCast]
  have hgf : ∀ x : ℤ, g (f x) = 0 := by
    intro x; rw [hf, hg, ZMod.intCast_zmod_eq_zero_iff_dvd]; exact dvd_mul_right _ _
  have eq0 : g.comp f = 0 :=
    LinearMap.ext fun x => by rw [LinearMap.comp_apply, hgf x, LinearMap.zero_apply]
  have hexact : Function.Exact f g := by
    rw [LinearMap.exact_iff]; ext y
    simp only [LinearMap.mem_ker, hg, ZMod.intCast_zmod_eq_zero_iff_dvd, LinearMap.mem_range, hf]
    constructor
    · rintro ⟨c, rfl⟩; exact ⟨c, rfl⟩
    · rintro ⟨c, rfl⟩; exact dvd_mul_right _ _
  have hinjf : Function.Injective f :=
    fun x y hxy => mul_left_cancel₀ ha' (by rw [← hf, ← hf, hxy])
  have hsurjg : Function.Surjective g := by
    intro z; obtain ⟨y, rfl⟩ := ZMod.intCast_surjective z; exact ⟨y, hg y⟩
  set S := ModuleCat.shortComplexOfCompEqZero f g eq0 with hSdef
  have hS : S.ShortExact := ModuleCat.shortComplex_shortExact S hexact hinjf hsurjg
  set Yc := ModuleCat.of ℤ Y with hY

  have hExactCS := Abelian.Ext.contravariantSequence_exact hS Yc 0 1 (by norm_num)

  let dhom : RepresentationTheory.CategoryTheory.Abelian.ExtensionClasses.CategoryTheory.ExtensionClasses S.X₁ Yc 0 →+ RepresentationTheory.CategoryTheory.Abelian.ExtensionClasses.CategoryTheory.ExtensionClasses S.X₃ Yc 1 :=
    hS.extClass.precomp Yc (by norm_num)
  let m12 : RepresentationTheory.CategoryTheory.Abelian.ExtensionClasses.CategoryTheory.ExtensionClasses S.X₂ Yc 0 →+ RepresentationTheory.CategoryTheory.Abelian.ExtensionClasses.CategoryTheory.ExtensionClasses S.X₁ Yc 0 :=
    (Abelian.Ext.mk₀ S.f).precomp Yc (zero_add 0)

  have hsurjδ : Function.Surjective dhom := by
    rw [← AddMonoidHom.range_eq_top,
      show dhom.range = _ from (hExactCS.exact' 2 3 4).ab_range_eq_ker]
    ext x
    simp only [AddSubgroup.mem_top, iff_true, AddMonoidHom.mem_ker]
    exact (Abelian.Ext.subsingleton_of_projective S.X₂ Yc 0).elim _ _
  have hkerδ : dhom.ker = m12.range := ((hExactCS.exact' 1 2 3).ab_range_eq_ker).symm

  let e0 : (RepresentationTheory.CategoryTheory.Abelian.ExtensionClasses.CategoryTheory.ExtensionClasses S.X₁ Yc 0) ≃+ Y :=
    (Abelian.Ext.addEquiv₀).trans (ModuleCat.homAddEquiv.trans
      (LinearMap.ringLmapEquivSelf ℤ ℤ Y).toAddEquiv)

  have hconj : ∀ β, e0 (m12 β) = natScalarLinearMap a Y (e0 β) := by
    intro β
    have hred : m12 β = (Abelian.Ext.mk₀ S.f).comp β (zero_add 0) := rfl
    have step1 : Abelian.Ext.addEquiv₀ (m12 β) = S.f ≫ Abelian.Ext.addEquiv₀ β := by
      rw [hred]
      apply Abelian.Ext.addEquiv₀.symm.injective
      rw [AddEquiv.symm_apply_apply, Abelian.Ext.addEquiv₀_symm_apply, ← Abelian.Ext.mk₀_comp_mk₀,
        Abelian.Ext.mk₀_addEquiv₀_apply]
    change (LinearMap.ringLmapEquivSelf ℤ ℤ Y)
        (ModuleCat.homAddEquiv (Abelian.Ext.addEquiv₀ (m12 β)))
      = natScalarLinearMap a Y ((LinearMap.ringLmapEquivSelf ℤ ℤ Y)
        (ModuleCat.homAddEquiv (Abelian.Ext.addEquiv₀ β)))
    rw [step1]
    simp only [ModuleCat.homAddEquiv_apply, ModuleCat.hom_comp,
      LinearMap.ringLmapEquivSelf_apply, natScalarLinearMap_apply]
    change (Abelian.Ext.addEquiv₀ β).hom (S.f.hom 1) = (a : ℤ) • (Abelian.Ext.addEquiv₀ β).hom 1
    rw [show S.f.hom (1 : ℤ) = (a : ℤ) • (1 : ℤ) from rfl, map_smul]

  let δL := dhom.toIntLinearMap
  have hsurjδL : Function.Surjective δL := hsurjδ
  let e0L : (RepresentationTheory.CategoryTheory.Abelian.ExtensionClasses.CategoryTheory.ExtensionClasses S.X₁ Yc 0) ≃ₗ[ℤ] Y := e0.toIntLinearEquiv
  have he0L : ∀ x, (e0L : (RepresentationTheory.CategoryTheory.Abelian.ExtensionClasses.CategoryTheory.ExtensionClasses S.X₁ Yc 0) →ₗ[ℤ] Y) x = e0 x := fun _ => rfl
  have hmap : Submodule.map (e0L : (RepresentationTheory.CategoryTheory.Abelian.ExtensionClasses.CategoryTheory.ExtensionClasses S.X₁ Yc 0) →ₗ[ℤ] Y) (LinearMap.ker δL)
      = Ideal.span {(a : ℤ)} • (⊤ : Submodule ℤ Y) := by
    rw [← range_natScalarLinearMap a Y]
    ext z
    simp only [Submodule.mem_map, LinearMap.mem_ker, LinearMap.mem_range, he0L]
    constructor
    · rintro ⟨y, hy, rfl⟩
      have hy' : y ∈ dhom.ker := AddMonoidHom.mem_ker.mpr hy
      rw [hkerδ] at hy'
      obtain ⟨u, hu⟩ := hy'
      exact ⟨e0 u, by rw [← hconj, hu]⟩
    · rintro ⟨w, rfl⟩
      refine ⟨m12 (e0.symm w), ?_, ?_⟩
      · have : m12 (e0.symm w) ∈ dhom.ker :=
          hkerδ.symm ▸ AddMonoidHom.mem_range.mpr ⟨e0.symm w, rfl⟩
        exact AddMonoidHom.mem_ker.mp this
      · rw [hconj, e0.apply_symm_apply]
  exact ⟨((LinearMap.quotKerEquivOfSurjective δL hsurjδL).symm.trans
    (Submodule.Quotient.equiv (LinearMap.ker δL) _ e0L hmap)).toAddEquiv⟩

/-- In degree one, the auxiliary integer construction on two cyclic modules is additively equivalent to their gcd cyclic module. -/
theorem auxiliaryIntZModDegreeOneGcdAddEquiv (a b : ℕ) (ha : a ≠ 0) (hb : b ≠ 0) :
    Nonempty (RepresentationTheory.CategoryTheory.Abelian.ExtensionClasses.CategoryTheory.ExtensionClasses (ModuleCat.of ℤ (ZMod a)) (ModuleCat.of ℤ (ZMod b)) 1
      ≃+ ZMod (Nat.gcd a b)) := by
  haveI : NeZero b := ⟨hb⟩
  obtain ⟨e⟩ := auxiliaryIntZModDegreeOneQuotientAddEquiv a ha (ZMod b)
  exact ⟨e.trans (quotientZModLinearEquivGcd a b).toAddEquiv⟩

private lemma zmod_hasProjectiveDimensionLT_two (a : ℕ) :
