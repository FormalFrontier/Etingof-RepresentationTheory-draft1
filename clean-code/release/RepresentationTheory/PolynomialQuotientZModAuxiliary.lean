/-- The canonical integer-linear map from a cyclic module to the cyclic module of the gcd. -/
def zModToGcdLinearMap (a b : ℕ) : ZMod b →ₗ[ℤ] ZMod (Nat.gcd a b) :=
  (ZMod.castHom (Nat.gcd_dvd_right a b) (ZMod (Nat.gcd a b))).toAddMonoidHom.toIntLinearMap

/-- The canonical map to the gcd cyclic module agrees with the corresponding cast map. -/
@[simp] lemma zModToGcdLinearMap_apply (a b : ℕ) (x : ZMod b) :
    zModToGcdLinearMap a b x = ZMod.castHom (Nat.gcd_dvd_right a b) (ZMod (Nat.gcd a b)) x := rfl

/-- The kernel of the canonical map to the gcd cyclic module is the submodule generated by the first modulus. -/
lemma ker_zModToGcdLinearMap (a b : ℕ) [NeZero b] :
    Ideal.span {(a : ℤ)} • (⊤ : Submodule ℤ (ZMod b)) = LinearMap.ker (zModToGcdLinearMap a b) := by
  set g := Nat.gcd a b with hg
  apply le_antisymm
  · rw [Submodule.smul_le]
    intro r hr n _
    rw [Ideal.mem_span_singleton] at hr
    obtain ⟨c, rfl⟩ := hr
    rw [LinearMap.mem_ker, map_smul]

    have hga : (a : ZMod g) = 0 := (ZMod.natCast_eq_zero_iff a g).mpr (Nat.gcd_dvd_left a b)
    rw [zsmul_eq_mul]
    push_cast
    rw [hga]
    ring
  · intro x hx
    rw [LinearMap.mem_ker, zModToGcdLinearMap_apply, ZMod.castHom_apply, ← ZMod.natCast_val x,
      ZMod.natCast_eq_zero_iff] at hx

    obtain ⟨t, ht⟩ := hx
    rw [Submodule.ideal_span_singleton_smul, Submodule.mem_smul_pointwise_iff_exists]

    obtain ⟨u, v, huv⟩ : ∃ u v : ℤ, (g : ℤ) = a * u + b * v :=
      ⟨Nat.gcdA a b, Nat.gcdB a b, by rw [hg]; exact_mod_cast Nat.gcd_eq_gcd_ab a b⟩
    refine ⟨(u : ZMod b) * (t : ZMod b), Submodule.mem_top, ?_⟩

    rw [zsmul_eq_mul]
    have hx' : x = (x.val : ZMod b) := (ZMod.natCast_zmod_val x).symm
    rw [hx', ht]
    have hbz : (b : ZMod b) = 0 := ZMod.natCast_self b
    have : (g : ZMod b) = (a : ZMod b) * (u : ZMod b) := by
      have := congrArg (fun z : ℤ => (z : ZMod b)) huv
      push_cast at this ⊢
      rw [this, hbz]; ring
    push_cast
    rw [this]
    ring

/-- A quotient of a cyclic module by the indicated generated submodule is linearly equivalent to the gcd cyclic module. -/
def quotientZModLinearEquivGcd (a b : ℕ) [NeZero b] :
    (ZMod b ⧸ (Ideal.span {(a : ℤ)} • (⊤ : Submodule ℤ (ZMod b)))) ≃ₗ[ℤ] ZMod (Nat.gcd a b) :=
  (Submodule.quotEquivOfEq _ _ (ker_zModToGcdLinearMap a b)).trans
    ((zModToGcdLinearMap a b).quotKerEquivOfSurjective (by
      intro y
      obtain ⟨x, rfl⟩ := ZMod.castHom_surjective (Nat.gcd_dvd_right a b) y
      exact ⟨x, rfl⟩))

/-- The integer-linear endomorphism of an additive group given by multiplication by a natural number. -/
def natScalarLinearMap (a : ℕ) (Y : Type*) [AddCommGroup Y] : Y →ₗ[ℤ] Y := (a : ℤ) • LinearMap.id

/-- Evaluating the natural scalar map gives the natural-number action. -/
@[simp] lemma natScalarLinearMap_apply (a : ℕ) {Y : Type*} [AddCommGroup Y] (x : Y) :
    natScalarLinearMap a Y x = (a : ℤ) • x := rfl

/-- The range of multiplication by a natural number is the submodule generated by that number. -/
lemma range_natScalarLinearMap (a : ℕ) (Y : Type*) [AddCommGroup Y] :
    LinearMap.range (natScalarLinearMap a Y) = Ideal.span {(a : ℤ)} • (⊤ : Submodule ℤ Y) := by
  rw [Submodule.ideal_span_singleton_smul]
  ext x
  simp only [LinearMap.mem_range, natScalarLinearMap_apply, Submodule.mem_smul_pointwise_iff_exists]
  exact ⟨fun ⟨y, hy⟩ => ⟨y, Submodule.mem_top, hy⟩, fun ⟨y, _, hy⟩ => ⟨y, hy⟩⟩

/-- The scalar-multiplication endomorphism of a cyclic integer module. -/
def zModNatScalarLinearMap (a b : ℕ) : ZMod b →ₗ[ℤ] ZMod b := natScalarLinearMap a (ZMod b)

/-- Evaluating the cyclic scalar map gives multiplication by the selected natural number. -/
@[simp] lemma zModNatScalarLinearMap_apply (a b : ℕ) (x : ZMod b) : zModNatScalarLinearMap a b x = (a : ℤ) • x := rfl

/-- The integer-linear map from the gcd cyclic module into the second cyclic module. -/
def zModGcdToZModLinearMap (a b : ℕ) [NeZero b] : ZMod (Nat.gcd a b) →ₗ[ℤ] ZMod b :=
  (ZMod.lift (Nat.gcd a b)
    ⟨zmultiplesHom (ZMod b) ((b / Nat.gcd a b : ℕ) : ZMod b), by
      simp only [zmultiplesHom_apply, zsmul_eq_mul]
      rw [Int.cast_natCast, ← Nat.cast_mul, Nat.mul_div_cancel' (Nat.gcd_dvd_right a b),
        ZMod.natCast_self]⟩).toIntLinearMap

/-- The map from the gcd cyclic module sends an integer class to the corresponding scaled integer. -/
lemma zModGcdToZModLinearMap_intCast (a b : ℕ) [NeZero b] (m : ℤ) :
    zModGcdToZModLinearMap a b (m : ZMod (Nat.gcd a b)) = m • ((b / Nat.gcd a b : ℕ) : ZMod b) := by
  simp only [zModGcdToZModLinearMap, AddMonoidHom.coe_toIntLinearMap, ZMod.lift_coe, zmultiplesHom_apply]

/-- The map from the gcd cyclic module sends a natural representative to the prescribed multiple. -/
lemma zModGcdToZModLinearMap_apply (a b : ℕ) [NeZero b] (y : ZMod (Nat.gcd a b)) :
    zModGcdToZModLinearMap a b y = (y.val : ℤ) • ((b / Nat.gcd a b : ℕ) : ZMod b) := by
  haveI : NeZero (Nat.gcd a b) := ⟨Nat.gcd_ne_zero_right (NeZero.ne b)⟩
  conv_lhs => rw [← ZMod.natCast_zmod_val y]
  rw [show ((y.val : ℕ) : ZMod (Nat.gcd a b)) = (((y.val : ℕ) : ℤ) : ZMod (Nat.gcd a b)) by
      push_cast; rfl, zModGcdToZModLinearMap_intCast]

/-- The kernel of cyclic scalar multiplication is linearly equivalent to the cyclic module of the gcd. -/
def kerZModNatScalarLinearEquivGcd (a b : ℕ) [NeZero b] :
    (LinearMap.ker (zModNatScalarLinearMap a b)) ≃ₗ[ℤ] ZMod (Nat.gcd a b) := by
  haveI : NeZero (Nat.gcd a b) := ⟨Nat.gcd_ne_zero_right (NeZero.ne b)⟩
  set g := Nat.gcd a b with hg
  have hgpos : 0 < g := Nat.pos_of_ne_zero (Nat.gcd_ne_zero_right (NeZero.ne b))
  have hb'pos : 0 < b / g :=
    Nat.div_pos (Nat.le_of_dvd (Nat.pos_of_ne_zero (NeZero.ne b)) (Nat.gcd_dvd_right a b)) hgpos
  have hinj : Function.Injective (zModGcdToZModLinearMap a b) := by
    rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
    intro x hx
    rw [LinearMap.mem_ker, zModGcdToZModLinearMap_apply, zsmul_eq_mul, Int.cast_natCast, ← Nat.cast_mul,
      ZMod.natCast_eq_zero_iff] at hx

    rw [← ZMod.natCast_zmod_val x, ZMod.natCast_eq_zero_iff]
    refine (Nat.mul_dvd_mul_iff_right hb'pos).mp ?_
    rwa [Nat.mul_div_cancel' (Nat.gcd_dvd_right a b)]
  have hz : (a : ℤ) • ((b / g : ℕ) : ZMod b) = 0 := by
    rw [zsmul_eq_mul, Int.cast_natCast, ← Nat.cast_mul, ZMod.natCast_eq_zero_iff]
    conv_lhs => rw [← Nat.mul_div_cancel' (Nat.gcd_dvd_right a b)]
    exact mul_dvd_mul_right (Nat.gcd_dvd_left a b) _
  have hrange : LinearMap.range (zModGcdToZModLinearMap a b) = LinearMap.ker (zModNatScalarLinearMap a b) := by
    apply le_antisymm
    · rintro _ ⟨y, rfl⟩
      rw [LinearMap.mem_ker, zModNatScalarLinearMap_apply, zModGcdToZModLinearMap_apply,
        smul_smul, mul_comm, ← smul_smul, hz, smul_zero]
    · intro x hx
      rw [LinearMap.mem_ker, zModNatScalarLinearMap_apply] at hx
      have h1 : b ∣ a * x.val := by
        rwa [← ZMod.natCast_zmod_val x, zsmul_eq_mul, Int.cast_natCast, ← Nat.cast_mul,
          ZMod.natCast_eq_zero_iff] at hx
      have haga' : a = g * (a / g) := (Nat.mul_div_cancel' (Nat.gcd_dvd_left a b)).symm
      have hcop : Nat.Coprime (b / g) (a / g) := (Nat.coprime_div_gcd_div_gcd hgpos).symm
      have hb'dvd : (b / g) ∣ x.val := by
        have hstep : (b / g) ∣ (a / g) * x.val := by
          apply Nat.dvd_of_mul_dvd_mul_left hgpos
          calc g * (b / g) = b := Nat.mul_div_cancel' (Nat.gcd_dvd_right a b)
            _ ∣ a * x.val := h1
            _ = g * ((a / g) * x.val) := by rw [← mul_assoc, ← haga']
        exact hcop.dvd_of_dvd_mul_left hstep
      obtain ⟨s, hs⟩ := hb'dvd
      refine ⟨((s : ℤ) : ZMod g), ?_⟩
      rw [zModGcdToZModLinearMap_intCast, zsmul_eq_mul, Int.cast_natCast, ← ZMod.natCast_zmod_val x, hs,
        Nat.cast_mul]
      ring
  exact ((LinearEquiv.ofInjective (zModGcdToZModLinearMap a b) hinj).trans
    (LinearEquiv.ofEq _ _ hrange)).symm

/-- The tensor product of two cyclic integer modules is linearly equivalent to the cyclic module of their gcd. -/
def tensorZModLinearEquivGcd (a b : ℕ) [NeZero b] :
    TensorProduct ℤ (ZMod a) (ZMod b) ≃ₗ[ℤ] ZMod (Nat.gcd a b) :=
  let e_a : ZMod a ≃ₗ[ℤ] (ℤ ⧸ Ideal.span {(a : ℤ)}) :=
    ((Int.quotientSpanNatEquivZMod a).symm.toAddEquiv).toIntLinearEquiv
  (TensorProduct.congr e_a (LinearEquiv.refl ℤ (ZMod b))) ≪≫ₗ
    (TensorProduct.quotTensorEquivQuotSMul (ZMod b) (Ideal.span {(a : ℤ)})) ≪≫ₗ
    quotientZModLinearEquivGcd a b

/-- Maps out of a cyclic module with nonzero modulus are additively equivalent to the kernel of multiplication by its modulus. -/
def linearMapZModKerAddEquiv (a : ℕ) (Y : Type*) [AddCommGroup Y] [NeZero a] :
    (ZMod a →ₗ[ℤ] Y) ≃+ LinearMap.ker (natScalarLinearMap a Y) where
  toFun f := ⟨f 1, by
    rw [LinearMap.mem_ker, natScalarLinearMap_apply, ← map_smul]
    have h1 : (a : ℤ) • (1 : ZMod a) = 0 := by
      rw [zsmul_eq_mul, mul_one, Int.cast_natCast, ZMod.natCast_self]
    rw [h1, map_zero]⟩
  invFun x := (ZMod.lift a ⟨zmultiplesHom Y (x : Y), by
    have hx := LinearMap.mem_ker.mp x.2
    rw [natScalarLinearMap_apply] at hx
    simpa only [zmultiplesHom_apply] using hx⟩).toIntLinearMap
  left_inv f := by
    ext z
    obtain ⟨n, rfl⟩ : ∃ n : ℤ, (n : ZMod a) = z :=
      ⟨(z.val : ℤ), by rw [Int.cast_natCast, ZMod.natCast_zmod_val]⟩
    rw [AddMonoidHom.coe_toIntLinearMap, ZMod.lift_coe]
    simp only [zmultiplesHom_apply]
    rw [← zsmul_one n, map_zsmul]
  right_inv x := by
    apply Subtype.ext
    change (ZMod.lift a ⟨zmultiplesHom Y (x : Y), _⟩).toIntLinearMap 1 = (x : Y)
    rw [AddMonoidHom.coe_toIntLinearMap,
      show (1 : ZMod a) = ((1 : ℤ) : ZMod a) by push_cast; rfl, ZMod.lift_coe]
    simp only [zmultiplesHom_apply, one_zsmul]
  map_add' f g := rfl

/-- Integer-linear maps between cyclic modules with nonzero moduli are additively equivalent to the cyclic module of their gcd. -/
def linearMapZModAddEquivGcd (a b : ℕ) [NeZero a] [NeZero b] :
    (ZMod a →ₗ[ℤ] ZMod b) ≃+ ZMod (Nat.gcd a b) :=
  (linearMapZModKerAddEquiv a (ZMod b)).trans (kerZModNatScalarLinearEquivGcd a b).toAddEquiv

/-- The kernel of nonzero natural-number multiplication on the integers is subsingleton. -/
lemma subsingleton_ker_natScalarLinearMapInt (a : ℕ) [NeZero a] :
    Subsingleton (LinearMap.ker (natScalarLinearMap a ℤ)) := by
  have hker : ∀ z : LinearMap.ker (natScalarLinearMap a ℤ), (z : ℤ) = 0 := by
    intro z
    have hz : (a : ℤ) • (z : ℤ) = 0 := LinearMap.mem_ker.mp z.2
    rw [smul_eq_mul, mul_eq_zero] at hz
    exact hz.resolve_left (Int.natCast_ne_zero.mpr (NeZero.ne a))
  exact ⟨fun x y => Subtype.ext (by rw [hker x, hker y])⟩

/-- Integer-linear maps from a cyclic module with nonzero modulus to the integers form a subsingleton. -/
lemma subsingleton_linearMapZModToInt (a : ℕ) [NeZero a] : Subsingleton (ZMod a →ₗ[ℤ] ℤ) := by
  haveI := subsingleton_ker_natScalarLinearMapInt a
  exact (linearMapZModKerAddEquiv a ℤ).toEquiv.subsingleton

end

/-- A cyclic integer module carries the displayed module structure over opposite integers. -/
noncomputable local instance zModOppositeIntModule (a : ℕ) : Module ℤᵐᵒᵖ (ZMod a) :=
  Module.compHom (ZMod a) ((RingHom.id ℤ).fromOpposite fun x y => mul_comm x y)

private lemma balancedSubgroup_zmod_eq_bot (a : ℕ) (N : Type) [AddCommGroup N] :
    RepresentationTheory.Algebra.Homology.TensorProductConstruction.integerTensorSubgroup ℤ N (ZMod a) = ⊥ := by
  rw [RepresentationTheory.Algebra.Homology.TensorProductConstruction.integerTensorSubgroup]
  apply le_antisymm _ bot_le
  rw [AddSubgroup.closure_le]
  rintro x ⟨r, m, n, rfl⟩
  simp only [SetLike.mem_coe, AddSubgroup.mem_bot]
  have hop : (MulOpposite.op r • m : ZMod a) = r • m := rfl
  rw [hop, sub_eq_zero]
  exact TensorProduct.smul_tmul r m n

/-- The degree-zero auxiliary categorical object from a cyclic module is isomorphic to the target modulo its generated scalar submodule. -/
theorem auxiliaryIntZModModuleDegreeZeroQuotientIso (a : ℕ) (N : Type) [AddCommGroup N] :
    Nonempty (RepresentationTheory.Algebra.Homology.TensorProductConstruction.degreewiseModuleGroup ℤ N (ModuleCat.of ℤᵐᵒᵖ (ZMod a)) 0
      ≅ AddCommGrpCat.of (N ⧸ (Ideal.span {(a : ℤ)} • (⊤ : Submodule ℤ N)))) := by
  obtain ⟨e₀⟩ := RepresentationTheory.DerivedFunctorExactness.AuxiliaryDegreeZeroIso ℤ N (ModuleCat.of ℤᵐᵒᵖ (ZMod a))
  refine ⟨e₀ ≪≫ AddEquiv.toAddCommGrpIso ?_⟩
  let e_a : ZMod a ≃ₗ[ℤ] (ℤ ⧸ Ideal.span {(a : ℤ)}) :=
    ((Int.quotientSpanNatEquivZMod a).symm.toAddEquiv).toIntLinearEquiv
  exact ((QuotientAddGroup.quotientAddEquivOfEq (balancedSubgroup_zmod_eq_bot a N)).trans
    QuotientAddGroup.quotientBot).trans
    (((TensorProduct.congr e_a (LinearEquiv.refl ℤ N)).trans
      (TensorProduct.quotTensorEquivQuotSMul N (Ideal.span {(a : ℤ)}))).toAddEquiv)

/-- The degree-zero auxiliary categorical object of two cyclic modules is isomorphic to the gcd cyclic module. -/
theorem auxiliaryZModDegreeZeroGcdIso (a b : ℕ) (ha : a ≠ 0) (hb : b ≠ 0) :
    Nonempty (RepresentationTheory.Algebra.Homology.TensorProductConstruction.degreewiseModuleGroup ℤ (ZMod b) (ModuleCat.of ℤᵐᵒᵖ (ZMod a)) 0
      ≅ AddCommGrpCat.of (ZMod (Nat.gcd a b))) := by
  haveI : NeZero a := ⟨ha⟩
  haveI : NeZero b := ⟨hb⟩

  obtain ⟨e₀⟩ := RepresentationTheory.DerivedFunctorExactness.AuxiliaryDegreeZeroIso ℤ (ZMod b) (ModuleCat.of ℤᵐᵒᵖ (ZMod a))
  refine ⟨e₀ ≪≫ AddEquiv.toAddCommGrpIso ?_⟩
  exact ((QuotientAddGroup.quotientAddEquivOfEq (balancedSubgroup_zmod_eq_bot a (ZMod b))).trans
    QuotientAddGroup.quotientBot).trans (tensorZModLinearEquivGcd a b).toAddEquiv

