import Mathlib
import EtingofRepresentationTheory.Chapter5.Problem5_24_2_Core
import EtingofRepresentationTheory.Chapter5.Problem5_24_2_Bridge
import EtingofRepresentationTheory.Chapter5.PermutationTraceWord

/-!
# Problem 5.24.2: the invariant ring is generated by trace-of-word functions (assembly)

**Problem 5.24.2.** Let `R_{k,N}` be the algebra of polynomials on the space of `k`-tuples of
complex `N × N` matrices `X₁, …, X_k`, invariant under simultaneous conjugation. An example of an
element of `R_{k,N}` is the function `T_w := Tr(w(X₁, …, X_k))`, where `w` is any finite word on a
`k`-letter alphabet. Show that `R_{k,N}` is generated by the elements `T_w`.

The coordinate ring `MatrixTupleRing`, the invariant subalgebra `invariantSubalgebra`, the
trace-of-word functions `traceWord`, and the `matrixWeight` multidegree grading are defined in
`Problem5_24_2_Core.lean`; the coordinate ↔ tensor evaluation pairing `endTensorEval` and the
range-identification statement are in `Problem5_24_2_Bridge.lean`; the tensor-trace ↔ trace-word
(cycle) combinatorics live in `PermutationTraceWord.lean`. This file assembles them into the First
Fundamental Theorem.

## The assembly

The deep `⊆` inclusion (`invariantSubalgebra_le_adjoin_traceWord`) reduces, via the multidegree
grading, to the fixed-multidegree core `weightedHomogeneous_invariant_mem_adjoin`: every
`matrixWeight`-homogeneous invariant lies in the trace subalgebra. That core is proved by the
book's Schur–Weyl argument:

1. **Coordinate ↔ tensor bridge** (`weightedHomogeneous_invariant_mem_range_endTensorEval`): a
   multidegree-`d` invariant `p` is the image `endTensorEval slot M = p` of some `GL(V)`-invariant
   tensor `M ∈ symGroupImage`, for a slot assignment `slot : Fin n → Fin k` of multidegree `d`
   (`n = ∑ᵢ dᵢ`).
2. **Permutation spanning** (`symGroupAlgHom_range`, i.e. Schur–Weyl `Theorem5_18_4_centralizers`):
   `symGroupImage` is the `ℂ`-span of the permutation operators `symGroupAction σ`, so `M` is a
   finite `ℂ`-linear combination `M = symGroupAlgHom x = ∑_σ x_σ • symGroupAction σ`.
3. **Tensor-trace ↔ trace-word identity**
   (`endTensorEval_symGroupAction_mem_adjoin`): the contraction
   `endTensorEval slot (symGroupAction σ)` of a permutation operator against the generic tensor is a
   product of trace-of-word functions (one per `σ`-cycle), hence lies in the trace subalgebra.

Since `endTensorEval slot` is `ℂ`-linear and the trace subalgebra is a `ℂ`-submodule closed under
finite sums, `p = ∑_σ x_σ • endTensorEval slot (symGroupAction σ)` lies in it.
-/

noncomputable section

namespace Etingof

open scoped Classical TensorProduct
open MvPolynomial Module

variable (k N : ℕ)

/-! ## Tensor-trace ↔ trace-word: the value on a permutation operator -/

/-- The per-orbit factor `trace (matrixCycleProd σ (X_{letter ·}) r)` of the cycle-trace identity is
a trace-of-word function: the ordered matrix product around the orbit of `r`,
`X_{letter r} · X_{letter (σ⁻¹ r)} · …`, is the word product `w = [letter r, letter (σ⁻¹ r), …]`
evaluated by `traceWord`. -/
theorem trace_matrixCycleProd_mem_range_traceWord (n : ℕ) (σ : Equiv.Perm (Fin n))
    (letter : Fin n → Fin k) (r : Fin n) :
    Matrix.trace (matrixCycleProd σ (fun i => genericMatrix k N (letter i)) r)
      ∈ Set.range (traceWord k N) := by
  refine ⟨(List.range (cyclePeriod σ r)).map (fun t => letter ((σ⁻¹ ^ t) r)), ?_⟩
  rw [traceWord, matrixCycleProd, List.map_map]
  rfl

/-- **Tensor-trace ↔ trace-word identity (coordinate-ring value on a permutation operator).**
The contraction `endTensorEval slot (symGroupAction σ)` of a permutation operator against the
generic tensor `⨂ⱼ X_{slot j}` factors as a product, over the `σ`-orbits, of trace-of-word functions
`traceWord`: on the orbit of a representative `r` the factor is the trace of the ordered product of
the generic matrices `X_{slot r} · X_{slot (σ⁻¹ r)} · … ` around the cycle, which is `traceWord` of
that cyclic word. -/
theorem endTensorEval_symGroupAction_mem_adjoin (n : ℕ) (slot : Fin n → Fin k)
    (σ : Equiv.Perm (Fin n)) :
    endTensorEval k N n slot (symGroupAction ℂ (BridgeV N) n σ).toLinearMap
      ∈ Algebra.adjoin ℂ (Set.range (traceWord k N)) := by
  classical
  -- Evaluate the contraction; the permutation matrix collapses the `f`-sum to `f = g ∘ σ⁻¹`, and
  -- reindexing the product by `j = σ i` gives the `matrixSum_eq_prod_orbit` form.
  have hval : endTensorEval k N n slot (symGroupAction ℂ (BridgeV N) n σ).toLinearMap
      = ∑ g : Fin n → Fin N, ∏ i : Fin n,
          genericMatrix k N (slot (σ i)) (g (σ i)) (g i) := by
    rw [endTensorEval_apply, Finset.sum_comm]
    refine Finset.sum_congr rfl fun g _ => ?_
    -- collapse the inner `f`-sum: only `f = g ∘ σ⁻¹` survives.
    have hcollapse : (∑ f : Fin n → Fin N,
          algebraMap ℂ (MatrixTupleRing k N)
            (LinearMap.toMatrix (tensorBasis N n) (tensorBasis N n)
              (symGroupAction ℂ (BridgeV N) n σ).toLinearMap f g)
            * genericTensorMatrix k N n slot g f)
        = genericTensorMatrix k N n slot g (g ∘ σ.symm) := by
      have hterm : ∀ f : Fin n → Fin N,
          algebraMap ℂ (MatrixTupleRing k N)
              (LinearMap.toMatrix (tensorBasis N n) (tensorBasis N n)
                (symGroupAction ℂ (BridgeV N) n σ).toLinearMap f g)
              * genericTensorMatrix k N n slot g f
            = if f = g ∘ σ.symm then genericTensorMatrix k N n slot g f else 0 := by
        intro f
        rw [toMatrix_symGroupAction, Equiv.Perm.inv_def,
          apply_ite (algebraMap ℂ (MatrixTupleRing k N)),
          map_one, map_zero, ite_mul, one_mul, zero_mul]
      simp_rw [hterm]
      rw [Finset.sum_ite_eq' Finset.univ (g ∘ σ.symm)
        (fun f => genericTensorMatrix k N n slot g f)]
      simp
    rw [hcollapse]
    -- reindex the product `∏ j` by `j = σ i`.
    simp only [genericTensorMatrix]
    rw [← Equiv.prod_comp σ (fun j => MvPolynomial.X (R := ℂ)
      ((slot j, g j, (g ∘ σ.symm) j) : Fin k × Fin N × Fin N))]
    refine Finset.prod_congr rfl fun i _ => ?_
    simp only [Function.comp_apply, Equiv.symm_apply_apply, genericMatrix]
  rw [hval, matrixSum_eq_prod_orbit σ (fun i => genericMatrix k N (slot (σ i)))]
  refine Subalgebra.prod_mem _ fun r _ => ?_
  exact Algebra.subset_adjoin
    (trace_matrixCycleProd_mem_range_traceWord k N n σ (fun i => slot (σ i)) r)

/-! ## The multidegree slot assignment -/

/-- A slot assignment `slot : Fin n → Fin k` realizing a multidegree `d` on `n = ∑ᵢ dᵢ` slots:
letter `i` is carried by exactly `d i` slots. Existence is the multiset "concatenate `d i` copies of
`i`" packaged as a function on `Fin (∑ᵢ dᵢ)`. -/
theorem exists_slot_of_multidegree (d : Fin k →₀ ℕ) :
    ∃ (n : ℕ) (slot : Fin n → Fin k),
      ∀ i : Fin k, (Finset.univ.filter fun j => slot j = i).card = d i := by
  classical
  -- Realize `Fin (∑ᵢ dᵢ)` as `Σ i, Fin (d i)` and let slot read off the first coordinate.
  refine ⟨∑ i : Fin k, d i, fun j => (finSigmaFinEquiv.symm j).1, fun i => ?_⟩
  -- The fiber of the first-coordinate map over `i` is `Fin (d i)`.
  have E : {j : Fin (∑ i : Fin k, d i) // (finSigmaFinEquiv.symm j).1 = i} ≃ Fin (d i) :=
    (finSigmaFinEquiv.symm.subtypeEquiv (q := fun t => t.1 = i) (fun _ => Iff.rfl)).trans
      (Equiv.sigmaSubtype (β := fun i' : Fin k => Fin (d i')) i)
  rw [← Fintype.card_subtype (fun j => (finSigmaFinEquiv.symm j).1 = i),
    Fintype.card_congr E, Fintype.card_fin]

/-! ## The First Fundamental Theorem -/

/-- **First Fundamental Theorem of matrix invariants, multihomogeneous case (Schur–Weyl core).**
Every `matrixWeight`-homogeneous conjugation-invariant polynomial lies in the subalgebra generated
by the trace-of-word functions `T_w`.

This is the substantive content of Problem 5.24.2, isolated to a fixed multidegree `d`. Following
the book's hint: the degree-`d` invariants form `⨂_i Sᵈⁱ(V ⊗ V*)`, which embeds into
`(V ⊗ V*)^{⊗n} = End(V)^{⊗n}` with `n = ∑ dᵢ`; by Schur–Weyl duality (Theorem 5.18.4, the double
centralizer theorem) the `GL(V)`-invariants of `End(V)^{⊗n}` are spanned by the permutation
operators `σ ∈ Sₙ`, whose contractions against the generic tensor are products of trace-of-word
functions (`endTensorEval_symGroupAction_mem_adjoin`). -/
theorem weightedHomogeneous_invariant_mem_adjoin (d : Fin k →₀ ℕ)
    {p : MatrixTupleRing k N}
    (hhom : IsWeightedHomogeneous (matrixWeight k N) p d)
    (hinv : p ∈ invariantSubalgebra k N) :
    p ∈ Algebra.adjoin ℂ (Set.range (traceWord k N)) := by
  -- Choose a slot assignment realizing the multidegree `d`.
  obtain ⟨n, slot, hslot⟩ := exists_slot_of_multidegree k d
  -- Coordinate ↔ tensor bridge: `p = endTensorEval slot M` for a `GL(V)`-invariant `M`.
  obtain ⟨M, hM, hMp⟩ :=
    weightedHomogeneous_invariant_mem_range_endTensorEval k N n d slot hslot hhom hinv
  -- Permutation spanning: `M = symGroupAlgHom x` is a `ℂ`-linear combination of `symGroupAction σ`.
  rw [← symGroupAlgHom_range] at hM
  obtain ⟨x, rfl⟩ := hM
  -- Push `endTensorEval slot` (linear) through the finite linear combination `x`.
  rw [← hMp]
  -- `symGroupAlgHom x = ∑_{σ ∈ x.support} x σ • symGroupAction σ`.
  have hxsum : symGroupAlgHom ℂ (BridgeV N) n x
      = ∑ σ ∈ x.coeff.support,
        x.coeff σ • (symGroupAction ℂ (BridgeV N) n σ).toLinearMap := by
    rw [symGroupAlgHom]
    rw [MonoidAlgebra.lift_apply]
    simp only [symGroupMonoidHom, MonoidHom.coe_mk, OneHom.coe_mk]
    rw [Finsupp.sum]
  suffices h : endTensorEval k N n slot (symGroupAlgHom ℂ (BridgeV N) n x)
      ∈ Algebra.adjoin ℂ (Set.range (traceWord k N)) by exact h
  rw [hxsum, map_sum]
  refine Subalgebra.sum_mem _ fun σ _ => ?_
  rw [map_smul]
  exact Subalgebra.smul_mem _ (endTensorEval_symGroupAction_mem_adjoin k N n slot σ) _

/-- **First Fundamental Theorem of matrix invariants (the deep inclusion).** Every polynomial
invariant under simultaneous conjugation lies in the subalgebra generated by the trace-of-word
functions `T_w`.

Reduction to the multihomogeneous case: an invariant `f` is the (finite) sum of its
`matrixWeight`-homogeneous components; each component is again invariant
(`weightedHomogeneousComponent_mem_invariantSubalgebra`) and homogeneous, so lies in the trace
subalgebra by `weightedHomogeneous_invariant_mem_adjoin` (the Schur–Weyl core), and the subalgebra
is closed under the finite sum. -/
theorem invariantSubalgebra_le_adjoin_traceWord :
    invariantSubalgebra k N ≤ Algebra.adjoin ℂ (Set.range (traceWord k N)) := by
  intro f hf
  set S := Algebra.adjoin ℂ (Set.range (traceWord k N)) with hS
  rw [← sum_weightedHomogeneousComponent (matrixWeight k N) f]
  -- The homogeneous components have finite support, contained in `weight '' f.support`.
  set s : Finset (Fin k →₀ ℕ) := f.support.image (Finsupp.weight (matrixWeight k N)) with hs
  have hsub : (Function.support fun m => weightedHomogeneousComponent (matrixWeight k N) m f)
      ⊆ (s : Set (Fin k →₀ ℕ)) := by
    intro m hm
    simp only [Function.mem_support] at hm
    by_contra hmem
    apply hm
    apply weightedHomogeneousComponent_eq_zero'
    intro d hd hweq
    apply hmem
    rw [hs, Finset.coe_image, Set.mem_image]
    exact ⟨d, hd, hweq⟩
  rw [finsum_eq_finsetSum_of_support_subset _ hsub]
  refine Subalgebra.sum_mem _ ?_
  intro d _
  exact weightedHomogeneous_invariant_mem_adjoin k N d
    (weightedHomogeneousComponent_isWeightedHomogeneous d f)
    (weightedHomogeneousComponent_mem_invariantSubalgebra k N d hf)

/-- Problem 5.24.2. The invariant ring `R_{k,N}` of polynomials on `k`-tuples of `N × N` matrices,
invariant under simultaneous conjugation, is generated as a `ℂ`-algebra by the trace-of-word
functions `T_w = Tr(w(X₁, …, X_k))`. The nontrivial `⊆` inclusion is the First Fundamental
Theorem `invariantSubalgebra_le_adjoin_traceWord`; the `⊇` inclusion is
`traceWord_mem_invariantSubalgebra`. -/
theorem invariantSubalgebra_eq_adjoin_traceWord :
    Algebra.adjoin ℂ (Set.range (traceWord k N)) = invariantSubalgebra k N :=
  le_antisymm
    (Algebra.adjoin_le (by rintro _ ⟨w, rfl⟩; exact traceWord_mem_invariantSubalgebra k N w))
    (invariantSubalgebra_le_adjoin_traceWord k N)

end Etingof
