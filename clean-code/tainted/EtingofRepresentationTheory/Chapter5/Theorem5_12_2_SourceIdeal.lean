import Mathlib
import EtingofRepresentationTheory.Chapter5.Definition5_12_1
import EtingofRepresentationTheory.Chapter5.Lemma5_13_1
import EtingofRepresentationTheory.Chapter5.Lemma5_13_3
import EtingofRepresentationTheory.Chapter5.Theorem5_12_2_Irreducible

/-!
# Theorem 5.12.2: the source Young-projector left ideal `ℂ[Sₙ]·c_λ`

Etingof's Theorem 5.12.2 defines the Specht module as the left ideal `V_λ = ℂ[Sₙ]·c_λ`
generated by the **normalized, source-order** Young projector `c_λ = a_λ·b_λ`
(`youngProjector`, row-then-column). The downstream implementation in
`Theorem5_12_2_Irreducible.lean` instead uses `SpechtModule n la = ℂ[Sₙ]·(b_λ·a_λ)`, the left
ideal on the *reversed, unnormalized* `YoungSymmetrizer = b_λ·a_λ`. Because `a_λ` and `b_λ`
do not commute these are a priori different left ideals.

This file closes the gap left open by #7437: it exposes

* `youngProjectorLeftIdeal n la = ℂ[Sₙ]·c_λ` (the source-defined left ideal), and
* an explicit `ℂ[Sₙ]`-linear isomorphism `spechtModule_linearEquiv_youngProjectorLeftIdeal`
  from `SpechtModule n la` onto `youngProjectorLeftIdeal n la`.

The isomorphism is built from the two right-multiplication maps `·b_λ` and `·a_λ`. Right
multiplication by `b_λ` sends `x·(b_λ a_λ) ↦ (x b_λ)·(a_λ b_λ)`, carrying `ℂ[Sₙ]·(b_λ a_λ)`
into `ℂ[Sₙ]·(a_λ b_λ)`; right multiplication by `a_λ` is the return map. Their composites are
the scalars of Lemma 5.13.1: `(b_λ a_λ)² = α·(b_λ a_λ)` (Lemma 5.13.3) and, dually,
`(a_λ b_λ)² = β·(a_λ b_λ)`. Both scalars are nonzero — `α` because `(b_λ a_λ)² ≠ 0`
(`young_symmetrizer_sq_ne_zero`), and `β` because `β = 0` would force `(b_λ a_λ)³ = 0`,
contradicting `(b_λ a_λ)³ = α²·(b_λ a_λ) ≠ 0`. Nonzero composites make each right-multiplication
map injective and surjective, hence the required isomorphism.

Normalization is invisible to the span: `c_λ = (|P_λ||Q_λ|)⁻¹·(a_λ b_λ)`, so
`ℂ[Sₙ]·c_λ = ℂ[Sₙ]·(a_λ b_λ)` (`youngProjectorLeftIdeal_eq_span_mul`), and dually
`SpechtModule n la = ℂ[Sₙ]·(b_λ a_λ) = ℂ[Sₙ]·(youngProjectorCol · youngProjectorRow)`
(`spechtModule_eq_span_projCol_mul_projRow`).
-/

namespace Etingof

noncomputable section

/-- The **source** Young-projector left ideal `V_λ = ℂ[Sₙ]·c_λ`, with `c_λ = a_λ·b_λ =
youngProjector` (Etingof Theorem 5.12.2, verbatim). This is the honest formalization of
Etingof's `V_λ`; the implementation `SpechtModule` uses the reversed, unnormalized generator
`b_λ·a_λ` instead. The two are isomorphic; see
`spechtModule_linearEquiv_youngProjectorLeftIdeal`. -/
noncomputable def youngProjectorLeftIdeal (n : ℕ) (la : Nat.Partition n) :
    Submodule (SymGroupAlgebra n) (SymGroupAlgebra n) :=
  Submodule.span (SymGroupAlgebra n) {youngProjector n la}

/-- Right multiplication `x ↦ x·y`, as a left-`ℂ[Sₙ]`-module homomorphism. Left multiplication
commutes past it, so it is `ℂ[Sₙ]`-linear for the left regular action. -/
private def rMul (n : ℕ) (y : SymGroupAlgebra n) :
    SymGroupAlgebra n →ₗ[SymGroupAlgebra n] SymGroupAlgebra n where
  toFun x := x * y
  map_add' x₁ x₂ := add_mul x₁ x₂ y
  map_smul' r x := by simp only [smul_eq_mul, RingHom.id_apply, mul_assoc]

/-! ## The two Lemma 5.13.1 scalars and their nonvanishing -/

/-- `b_λ·a_λ = YoungSymmetrizer` is nonzero (its square is nonzero). -/
private lemma youngSym_ne (n : ℕ) (la : Nat.Partition n) :
    YoungSymmetrizer n la ≠ 0 :=
  fun h => young_symmetrizer_sq_ne_zero n la (by rw [h, mul_zero])

/-- `(b_λ a_λ)² = α·(b_λ a_λ)` with `α ≠ 0` (Lemma 5.13.3 plus `(b_λ a_λ)² ≠ 0`). -/
private lemma youngSym_sq (n : ℕ) (la : Nat.Partition n) :
    ∃ α : ℂ, α ≠ 0 ∧
      YoungSymmetrizer n la * YoungSymmetrizer n la = α • YoungSymmetrizer n la := by
  obtain ⟨α, hα⟩ := Etingof.Lemma5_13_3 n la
  exact ⟨α, fun h => young_symmetrizer_sq_ne_zero n la (by rw [hα, h, zero_smul]), hα⟩

/-- Dual to `youngSym_sq`: the unnormalized source-order product `(a_λ b_λ)` is idempotent
up to a nonzero scalar. The identity is the `x = b_λ a_λ` instance of the source-order
Lemma 5.13.1. -/
theorem rowCol_sq_scalar (n : ℕ) (la : Nat.Partition n) :
    ∃ β : ℂ, β ≠ 0 ∧
      (RowSymmetrizer n la * ColumnAntisymmetrizer n la) *
        (RowSymmetrizer n la * ColumnAntisymmetrizer n la) =
        β • (RowSymmetrizer n la * ColumnAntisymmetrizer n la) := by
  obtain ⟨ℓ, hℓ⟩ := Etingof.Lemma5_13_1_dual n la
  obtain ⟨α, hαne, hα⟩ := youngSym_sq n la
  have hsq : (RowSymmetrizer n la * ColumnAntisymmetrizer n la) *
      (RowSymmetrizer n la * ColumnAntisymmetrizer n la) =
      ℓ (YoungSymmetrizer n la) • (RowSymmetrizer n la * ColumnAntisymmetrizer n la) := by
    have h := hℓ (YoungSymmetrizer n la)
    rw [show RowSymmetrizer n la * YoungSymmetrizer n la * ColumnAntisymmetrizer n la
        = (RowSymmetrizer n la * ColumnAntisymmetrizer n la) *
          (RowSymmetrizer n la * ColumnAntisymmetrizer n la) from by
        simp only [YoungSymmetrizer, mul_assoc]] at h
    exact h
  refine ⟨ℓ (YoungSymmetrizer n la), ?_, hsq⟩
  intro hβ0
  rw [hβ0, zero_smul] at hsq
  have hcube0 : YoungSymmetrizer n la * YoungSymmetrizer n la * YoungSymmetrizer n la = 0 := by
    rw [show YoungSymmetrizer n la * YoungSymmetrizer n la * YoungSymmetrizer n la
        = ColumnAntisymmetrizer n la *
          ((RowSymmetrizer n la * ColumnAntisymmetrizer n la) *
           (RowSymmetrizer n la * ColumnAntisymmetrizer n la)) * RowSymmetrizer n la from by
        simp only [YoungSymmetrizer, mul_assoc], hsq, mul_zero, zero_mul]
  have hcube_eq : YoungSymmetrizer n la * YoungSymmetrizer n la * YoungSymmetrizer n la
      = (α * α) • YoungSymmetrizer n la := by
    rw [hα, smul_mul_assoc, hα, smul_smul]
  rw [hcube_eq] at hcube0
  exact (fun h => young_symmetrizer_sq_ne_zero n la (by rw [h, mul_zero]))
    ((smul_eq_zero.mp hcube0).resolve_left (mul_ne_zero hαne hαne))

/-! ## The composites of the right-multiplication maps -/

/-- `(x·b_λ)·a_λ = α·x` for `x ∈ ℂ[Sₙ]·(b_λ a_λ)`: the "there and back" composite on the
Specht module is multiplication by the Lemma 5.13.3 scalar `α`. -/
private lemma comp_left (n : ℕ) (la : Nat.Partition n) (α : ℂ)
    (hα : YoungSymmetrizer n la * YoungSymmetrizer n la = α • YoungSymmetrizer n la) :
    ∀ z ∈ SpechtModule n la,
      z * ColumnAntisymmetrizer n la * RowSymmetrizer n la = α • z := by
  intro z hz
  simp only [SpechtModule, Submodule.mem_span_singleton] at hz
  obtain ⟨x, rfl⟩ := hz
  rw [smul_eq_mul,
    show x * YoungSymmetrizer n la * ColumnAntisymmetrizer n la * RowSymmetrizer n la
      = x * (YoungSymmetrizer n la * YoungSymmetrizer n la) from by
        simp only [YoungSymmetrizer, mul_assoc],
    hα, mul_smul_comm]

/-- `(w·a_λ)·b_λ = β·w` for `w ∈ ℂ[Sₙ]·(a_λ b_λ)`: the "there and back" composite on the
source ideal is multiplication by the dual scalar `β`. -/
private lemma comp_right (n : ℕ) (la : Nat.Partition n) (β : ℂ)
    (hβ : (RowSymmetrizer n la * ColumnAntisymmetrizer n la) *
          (RowSymmetrizer n la * ColumnAntisymmetrizer n la) =
          β • (RowSymmetrizer n la * ColumnAntisymmetrizer n la)) :
    ∀ w ∈ Submodule.span (SymGroupAlgebra n)
        {RowSymmetrizer n la * ColumnAntisymmetrizer n la},
      w * RowSymmetrizer n la * ColumnAntisymmetrizer n la = β • w := by
  intro w hw
  simp only [Submodule.mem_span_singleton] at hw
  obtain ⟨y, rfl⟩ := hw
  rw [smul_eq_mul,
    show y * (RowSymmetrizer n la * ColumnAntisymmetrizer n la) * RowSymmetrizer n la
        * ColumnAntisymmetrizer n la
      = y * ((RowSymmetrizer n la * ColumnAntisymmetrizer n la) *
             (RowSymmetrizer n la * ColumnAntisymmetrizer n la)) from by
        simp only [mul_assoc],
    hβ, mul_smul_comm]

/-! ## The two right-multiplication maps land in the opposite ideal -/

/-- Right multiplication by `b_λ` carries `ℂ[Sₙ]·(b_λ a_λ)` into `ℂ[Sₙ]·(a_λ b_λ)`. -/
private lemma fwd_maps (n : ℕ) (la : Nat.Partition n) :
    ∀ z ∈ SpechtModule n la, z * ColumnAntisymmetrizer n la ∈
      Submodule.span (SymGroupAlgebra n)
        {RowSymmetrizer n la * ColumnAntisymmetrizer n la} := by
  intro z hz
  simp only [SpechtModule, Submodule.mem_span_singleton] at hz ⊢
  obtain ⟨x, rfl⟩ := hz
  refine ⟨x * ColumnAntisymmetrizer n la, ?_⟩
  rw [smul_eq_mul, smul_eq_mul]
  simp only [YoungSymmetrizer, mul_assoc]

/-- Right multiplication by `a_λ` carries `ℂ[Sₙ]·(a_λ b_λ)` back into `ℂ[Sₙ]·(b_λ a_λ)`. -/
private lemma bwd_maps (n : ℕ) (la : Nat.Partition n) :
    ∀ w ∈ Submodule.span (SymGroupAlgebra n)
        {RowSymmetrizer n la * ColumnAntisymmetrizer n la},
      w * RowSymmetrizer n la ∈ SpechtModule n la := by
  intro w hw
  simp only [SpechtModule, Submodule.mem_span_singleton] at hw ⊢
  obtain ⟨y, rfl⟩ := hw
  refine ⟨y * RowSymmetrizer n la, ?_⟩
  rw [smul_eq_mul, smul_eq_mul]
  simp only [YoungSymmetrizer, mul_assoc]

/-! ## The isomorphism to the reversed-order span, then to the source ideal -/

/-- `SpechtModule n la = ℂ[Sₙ]·(b_λ a_λ) ≃ₗ ℂ[Sₙ]·(a_λ b_λ)`, right multiplication by `b_λ`.
Injectivity and surjectivity come from the two nonzero composites `comp_left`/`comp_right`. -/
noncomputable def spechtModule_linearEquiv_span (n : ℕ) (la : Nat.Partition n) :
    SpechtModule n la ≃ₗ[SymGroupAlgebra n]
      Submodule.span (SymGroupAlgebra n)
        {RowSymmetrizer n la * ColumnAntisymmetrizer n la} := by
  refine LinearEquiv.ofBijective
    ((rMul n (ColumnAntisymmetrizer n la)).restrict (fwd_maps n la)) ⟨?_, ?_⟩
  · -- injective: `G ∘ F = α • id` with `α ≠ 0`
    obtain ⟨α, hαne, hα⟩ := youngSym_sq n la
    intro z₁ z₂ h
    have hFG : ∀ z : SpechtModule n la,
        ((rMul n (RowSymmetrizer n la)).restrict (bwd_maps n la))
          ((rMul n (ColumnAntisymmetrizer n la)).restrict (fwd_maps n la) z) = α • z :=
      fun z => Subtype.ext (comp_left n la α hα _ z.2)
    have h2 : α • z₁ = α • z₂ := by rw [← hFG z₁, ← hFG z₂, h]
    calc z₁ = α⁻¹ • (α • z₁) := by rw [smul_smul, inv_mul_cancel₀ hαne, one_smul]
      _ = α⁻¹ • (α • z₂) := by rw [h2]
      _ = z₂ := by rw [smul_smul, inv_mul_cancel₀ hαne, one_smul]
  · -- surjective: `F ∘ G = β • id` with `β ≠ 0`
    obtain ⟨β, hβne, hβ⟩ := rowCol_sq_scalar n la
    intro w
    have hGF : ((rMul n (ColumnAntisymmetrizer n la)).restrict (fwd_maps n la))
        (((rMul n (RowSymmetrizer n la)).restrict (bwd_maps n la)) w) = β • w :=
      Subtype.ext (comp_right n la β hβ _ w.2)
    exact ⟨β⁻¹ • ((rMul n (RowSymmetrizer n la)).restrict (bwd_maps n la)) w, by
      rw [LinearMap.map_smul_of_tower, hGF, smul_smul, inv_mul_cancel₀ hβne, one_smul]⟩

/-- `youngProjector = (|P_λ||Q_λ|)⁻¹·(a_λ b_λ)`: the source projector is the row-then-column
sum divided by the positive scalar `|P_λ|·|Q_λ|`. -/
private lemma youngProjector_eq_smul (n : ℕ) (la : Nat.Partition n) :
    youngProjector n la =
      ((Nat.card (RowSubgroup n la) : ℂ)⁻¹ * (Nat.card (ColumnSubgroup n la) : ℂ)⁻¹) •
        (RowSymmetrizer n la * ColumnAntisymmetrizer n la) := by
  rw [youngProjector, youngProjectorRow, youngProjectorCol, Algebra.smul_mul_assoc,
    Algebra.mul_smul_comm, smul_smul]

/-- Scaling the generator by a nonzero complex number does not change the left ideal it spans. -/
private lemma span_smul_scalar_eq (n : ℕ) {c : ℂ} (hc : c ≠ 0) (y : SymGroupAlgebra n) :
    Submodule.span (SymGroupAlgebra n) {c • y} =
      Submodule.span (SymGroupAlgebra n) {y} := by
  rw [show c • y = (algebraMap ℂ (SymGroupAlgebra n) c) • y from
    (algebraMap_smul (SymGroupAlgebra n) c y).symm]
  exact Submodule.span_singleton_smul_eq
    ((isUnit_iff_ne_zero.mpr hc).map (algebraMap ℂ (SymGroupAlgebra n))) y

/-- The source ideal `ℂ[Sₙ]·c_λ` equals `ℂ[Sₙ]·(a_λ b_λ)`: normalization is invisible to the
span. -/
lemma youngProjectorLeftIdeal_eq_span_mul (n : ℕ) (la : Nat.Partition n) :
    youngProjectorLeftIdeal n la =
      Submodule.span (SymGroupAlgebra n)
        {RowSymmetrizer n la * ColumnAntisymmetrizer n la} := by
  rw [show youngProjectorLeftIdeal n la =
      Submodule.span (SymGroupAlgebra n) {youngProjector n la} from rfl,
    youngProjector_eq_smul]
  exact span_smul_scalar_eq n
    (mul_ne_zero (inv_ne_zero (Nat.cast_ne_zero.mpr Nat.card_pos.ne'))
      (inv_ne_zero (Nat.cast_ne_zero.mpr Nat.card_pos.ne'))) _

/-- The implementation Specht module is spanned equally well by the normalized reversed product
`b_λ·a_λ = youngProjectorCol · youngProjectorRow` (the span is blind to the nonzero scalar
bridge `youngProjectorCol_mul_youngProjectorRow`). -/
lemma spechtModule_eq_span_projCol_mul_projRow (n : ℕ) (la : Nat.Partition n) :
    SpechtModule n la =
      Submodule.span (SymGroupAlgebra n) {youngProjectorCol n la * youngProjectorRow n la} := by
  rw [show SpechtModule n la =
      Submodule.span (SymGroupAlgebra n) {YoungSymmetrizer n la} from rfl,
    youngProjectorCol_mul_youngProjectorRow]
  exact (span_smul_scalar_eq n
    (inv_ne_zero (mul_ne_zero (Nat.cast_ne_zero.mpr Nat.card_pos.ne')
      (Nat.cast_ne_zero.mpr Nat.card_pos.ne'))) (YoungSymmetrizer n la)).symm

/-- **The gap closed.** An explicit `ℂ[Sₙ]`-linear isomorphism between the implementation Specht
module `SpechtModule n la = ℂ[Sₙ]·(b_λ a_λ)` and Etingof's source-defined left ideal
`youngProjectorLeftIdeal n la = ℂ[Sₙ]·c_λ` (`c_λ = a_λ b_λ`). In particular the source ideal
`V_λ` is irreducible, transporting `Theorem5_12_2_irreducible` along this isomorphism. -/
noncomputable def spechtModule_linearEquiv_youngProjectorLeftIdeal (n : ℕ) (la : Nat.Partition n) :
    SpechtModule n la ≃ₗ[SymGroupAlgebra n] youngProjectorLeftIdeal n la :=
  (spechtModule_linearEquiv_span n la).trans
    (LinearEquiv.ofEq _ _ (youngProjectorLeftIdeal_eq_span_mul n la).symm)

/-- The source-defined left ideal `V_λ = ℂ[Sₙ]·c_λ` is an irreducible `ℂ[Sₙ]`-module
(Etingof Theorem 5.12.2, verbatim), by transport of `Theorem5_12_2_irreducible` along the
isomorphism `spechtModule_linearEquiv_youngProjectorLeftIdeal`. -/
theorem youngProjectorLeftIdeal_isSimpleModule (n : ℕ) (la : Nat.Partition n) :
    IsSimpleModule (SymGroupAlgebra n) (youngProjectorLeftIdeal n la) :=
  (spechtModule_linearEquiv_youngProjectorLeftIdeal n la).isSimpleModule_iff.mp
    (Theorem5_12_2_irreducible n la)

/-- Etingof's source-order Young projector `c_λ = a_λ b_λ` is nonzero.  This is the
claim immediately following its definition: its principal left ideal is isomorphic to the
nonzero simple Specht module, so that ideal cannot be bottom. -/
theorem youngProjector_ne_zero (n : ℕ) (la : Nat.Partition n) :
    youngProjector n la ≠ 0 := by
  intro hzero
  haveI : IsSimpleModule (SymGroupAlgebra n) (youngProjectorLeftIdeal n la) :=
    youngProjectorLeftIdeal_isSimpleModule n la
  have hne : youngProjectorLeftIdeal n la ≠ ⊥ :=
    Submodule.nontrivial_iff_ne_bot.mp
      (IsSimpleModule.nontrivial (SymGroupAlgebra n) (youngProjectorLeftIdeal n la))
  apply hne
  simp [youngProjectorLeftIdeal, hzero]

end

end Etingof
