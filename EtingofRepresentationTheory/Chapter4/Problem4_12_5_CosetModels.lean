import EtingofRepresentationTheory.Chapter4.Problem4_12_5

/-!
# Concrete icosahedral models for Problem 4.12.5

`Chapter4/Problem4_12_5.lean` proves the three decomposition theorems
(`vertices_decomposition`, `faces_decomposition`, `edges_decomposition`) for *any* transitive
action `act : A₅ →* Equiv.Perm (Fin N)` with point stabilizers of order `5`, `3`, `2`
(`N = 12, 20, 30`). It never exhibits such an action, so the three theorems are conditional and
their non-vacuity rests on an unformalized appeal to the geometry of the icosahedron.

This file removes that gap. It constructs the actions, verifies the hypotheses, and derives
unconditional corollaries.

## The models

The rotation group of the regular icosahedron is `A₅`, acting transitively on the `12` vertices,
the `20` faces and the `30` edges. The stabilizer of a vertex is the cyclic group of order `5`
generated by the rotation about that vertex; of a face, the cyclic group of order `3`; of an
edge, the cyclic group of order `2` generated by the half-turn about the edge's midpoint. Each
of these actions is therefore the left-translation action of `A₅` on the coset space `A₅ ⧸ H`
for `H` cyclic of order `5`, `3`, `2` respectively, and those coset spaces have
`60 / 5 = 12`, `60 / 3 = 20`, `60 / 2 = 30` elements.

We build exactly those coset models, taking `H` to be `⟨classRepA5 3⟩`, `⟨classRepA5 1⟩`,
`⟨classRepA5 2⟩` — the cyclic subgroups generated by the class representatives of orders `5`,
`3`, `2` already fixed in `Chapter4/Example4_8_1/A5Classes.lean` — and transport along a
bijection with `Fin N`.

## Why the coset model is *the* icosahedral action

`transitiveEquivQuotient` shows every transitive `act` on `Fin N` is equivariantly isomorphic to
the coset action on `A₅ ⧸ stabSub act i₀`, and `quotientEquivOfConjSubgroup` shows conjugate
subgroups give equivariantly isomorphic coset spaces. Since all Sylow `5`-subgroups, all Sylow
`3`-subgroups and all involutions of `A₅` are conjugate, this gives
`unique_transitive_model`: any two transitive `A₅`-actions on `Fin N` with point stabilizers of
the same prime order `5`, `3` or `2` are equivariantly isomorphic. So whichever concrete model
of the icosahedron one starts from, its vertex/face/edge action *is* the model built here, and
the decompositions below are statements about the genuine icosahedral representations rather
than about one arbitrary choice.

## Main results

* `verticesAct`, `facesAct`, `edgesAct` — the constructed actions on `Fin 12`, `Fin 20`,
  `Fin 30`, with their transitivity and stabilizer-order lemmas.
* `vertices_decomposition_icosahedral`, `faces_decomposition_icosahedral`,
  `edges_decomposition_icosahedral` — the three decompositions with no hypotheses.
* `unique_transitive_model` — model independence.
-/

noncomputable section

namespace Etingof.Problem4_12_5

open Finset MulAction

/-! ## Orbit-stabilizer: transitivity forces the stabilizer order

The point-stabilizer order is not an extra assumption on top of transitivity, it is determined
by the degree: for a transitive action of `G` on `Fin n`, `n * |stabilizer| = |G|`. This is the
`g = 1` case of the orbit-stabilizer identity `fix_mul_stab_card` already proved in
`Problem4_12_5.lean`. -/

section OrbitStabilizer

variable {G : Type*} [Group G] [Fintype G] [DecidableEq G] {n : ℕ}

set_option linter.unusedSectionVars false
set_option linter.unusedDecidableInType false
set_option linter.unusedFintypeInType false

/-- **Orbit-stabilizer**, in `Finset.filter` form: for a transitive action on `Fin n`, the degree
times the order of a point stabilizer is the order of the group. -/
lemma card_mul_stab_filter_card (act : G →* Equiv.Perm (Fin n)) (i₀ : Fin n)
    (htrans : ∀ j : Fin n, ∃ x : G, act x i₀ = j) :
    n * (univ.filter (fun x : G => act x i₀ = i₀)).card = Fintype.card G := by
  have h := fix_mul_stab_card act 1 i₀ htrans
  have hfix : (univ.filter (fun i : Fin n => act 1 i = i)).card = n := by
    rw [Finset.filter_true_of_mem (fun i _ => by simp), Finset.card_univ, Fintype.card_fin]
  have hconj : (univ.filter (fun x : G => act (x⁻¹ * 1 * x) i₀ = i₀)).card = Fintype.card G := by
    rw [Finset.filter_true_of_mem (fun x _ => by simp), Finset.card_univ]
  rwa [hfix, hconj] at h

/-- **Orbit-stabilizer**, in `Nat.card` form — the shape the decomposition theorems take their
`hstab` hypothesis in. -/
lemma card_mul_card_stab (act : G →* Equiv.Perm (Fin n)) (i₀ : Fin n)
    (htrans : ∀ j : Fin n, ∃ x : G, act x i₀ = j) :
    n * Nat.card {g : G // act g i₀ = i₀} = Nat.card G := by
  rw [Nat.card_eq_fintype_card (α := {g : G // act g i₀ = i₀}), Fintype.card_subtype,
    Nat.card_eq_fintype_card (α := G)]
  exact card_mul_stab_filter_card act i₀ htrans

end OrbitStabilizer

/-! ## Transporting a coset action to `Fin N` -/

section CosetModel

/-- Transport of permutations along a bijection of the underlying sets, as a group
homomorphism. -/
def permCongrHom {X Y : Type*} (e : X ≃ Y) : Equiv.Perm X →* Equiv.Perm Y where
  toFun := e.permCongr
  map_one' := by ext y; simp [Equiv.permCongr_def]
  map_mul' p q := by ext y; simp [Equiv.permCongr_def]

variable {G : Type*} [Group G] (H : Subgroup G) {N : ℕ}

/-- The action of `G` on `Fin N` obtained from the left-translation action on the coset space
`G ⧸ H`, transported along a bijection `e : (G ⧸ H) ≃ Fin N`. -/
def cosetAct (e : (G ⧸ H) ≃ Fin N) : G →* Equiv.Perm (Fin N) :=
  (permCongrHom e).comp (MulAction.toPermHom G (G ⧸ H))

@[simp] lemma cosetAct_apply (e : (G ⧸ H) ≃ Fin N) (g : G) (i : Fin N) :
    cosetAct H e g i = e (g • e.symm i) := rfl

/-- The coset action is transitive: `G` acts transitively on `G ⧸ H` by left translation. -/
lemma cosetAct_transitive (e : (G ⧸ H) ≃ Fin N) (i j : Fin N) :
    ∃ g : G, cosetAct H e g i = j := by
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq G (e.symm i) (e.symm j)
  exact ⟨g, by rw [cosetAct_apply, hg, Equiv.apply_symm_apply]⟩

/-- The coset space `G ⧸ H` has `|G| / |H|` elements. -/
lemma card_quotient_mul_card (H : Subgroup G) : Nat.card (G ⧸ H) * Nat.card H = Nat.card G := by
  rw [← Subgroup.index_eq_card]; exact H.index_mul_card

end CosetModel

/-! ## The three icosahedral models

`classRepA5 3`, `classRepA5 1`, `classRepA5 2` have orders `5`, `3`, `2` (`ord_cr3`, `ord_cr1`,
`ord_cr2` in `Problem4_12_5.lean`), so the cyclic subgroups they generate are the vertex, face
and edge stabilizers of the icosahedron. -/

section Icosahedron

open Etingof.Example4_8_1.A5

/-- The vertex stabilizer of the icosahedron: a cyclic subgroup of `A₅` of order `5`. -/
def vertexStab : Subgroup A5 := Subgroup.zpowers (classRepA5 3)

/-- The face stabilizer of the icosahedron: a cyclic subgroup of `A₅` of order `3`. -/
def faceStab : Subgroup A5 := Subgroup.zpowers (classRepA5 1)

/-- The edge stabilizer of the icosahedron: a cyclic subgroup of `A₅` of order `2`, generated by
the half-turn about the edge's midpoint. -/
def edgeStab : Subgroup A5 := Subgroup.zpowers (classRepA5 2)

lemma card_vertexStab : Nat.card vertexStab = 5 := by
  rw [vertexStab, Nat.card_zpowers, ord_cr3]

lemma card_faceStab : Nat.card faceStab = 3 := by
  rw [faceStab, Nat.card_zpowers, ord_cr1]

lemma card_edgeStab : Nat.card edgeStab = 2 := by
  rw [edgeStab, Nat.card_zpowers, ord_cr2]

/-- The icosahedron has `12` vertices: `[A₅ : ⟨5-cycle⟩] = 60 / 5 = 12`. -/
lemma card_quotient_vertexStab : Nat.card (A5 ⧸ vertexStab) = 12 := by
  have h := card_quotient_mul_card vertexStab
  rw [card_vertexStab, card_A5] at h
  omega

/-- The icosahedron has `20` faces: `[A₅ : ⟨3-cycle⟩] = 60 / 3 = 20`. -/
lemma card_quotient_faceStab : Nat.card (A5 ⧸ faceStab) = 20 := by
  have h := card_quotient_mul_card faceStab
  rw [card_faceStab, card_A5] at h
  omega

/-- The icosahedron has `30` edges: `[A₅ : ⟨involution⟩] = 60 / 2 = 30`. -/
lemma card_quotient_edgeStab : Nat.card (A5 ⧸ edgeStab) = 30 := by
  have h := card_quotient_mul_card edgeStab
  rw [card_edgeStab, card_A5] at h
  omega

/-- A labelling of the `12` vertices of the icosahedron by `Fin 12`. -/
def vertexEquiv : (A5 ⧸ vertexStab) ≃ Fin 12 := Finite.equivFinOfCardEq card_quotient_vertexStab

/-- A labelling of the `20` faces of the icosahedron by `Fin 20`. -/
def faceEquiv : (A5 ⧸ faceStab) ≃ Fin 20 := Finite.equivFinOfCardEq card_quotient_faceStab

/-- A labelling of the `30` edges of the icosahedron by `Fin 30`. -/
def edgeEquiv : (A5 ⧸ edgeStab) ≃ Fin 30 := Finite.equivFinOfCardEq card_quotient_edgeStab

/-- **The vertex action of `A₅` on the icosahedron**, as a permutation action on `Fin 12`. -/
def verticesAct : A5 →* Equiv.Perm (Fin 12) := cosetAct vertexStab vertexEquiv

/-- **The face action of `A₅` on the icosahedron**, as a permutation action on `Fin 20`. -/
def facesAct : A5 →* Equiv.Perm (Fin 20) := cosetAct faceStab faceEquiv

/-- **The edge action of `A₅` on the icosahedron**, as a permutation action on `Fin 30`. -/
def edgesAct : A5 →* Equiv.Perm (Fin 30) := cosetAct edgeStab edgeEquiv

lemma verticesAct_transitive : ∀ i j : Fin 12, ∃ g : A5, verticesAct g i = j :=
  cosetAct_transitive vertexStab vertexEquiv

lemma facesAct_transitive : ∀ i j : Fin 20, ∃ g : A5, facesAct g i = j :=
  cosetAct_transitive faceStab faceEquiv

lemma edgesAct_transitive : ∀ i j : Fin 30, ∃ g : A5, edgesAct g i = j :=
  cosetAct_transitive edgeStab edgeEquiv

/-- Vertex stabilizers have order `5`, as required by `vertices_decomposition`. -/
lemma verticesAct_stab (i : Fin 12) : Nat.card {g : A5 // verticesAct g i = i} = 5 := by
  have h := card_mul_card_stab verticesAct i (fun j => verticesAct_transitive i j)
  rw [card_A5] at h
  omega

/-- Face stabilizers have order `3`, as required by `faces_decomposition`. -/
lemma facesAct_stab (i : Fin 20) : Nat.card {g : A5 // facesAct g i = i} = 3 := by
  have h := card_mul_card_stab facesAct i (fun j => facesAct_transitive i j)
  rw [card_A5] at h
  omega

/-- Edge stabilizers have order `2`, as required by `edges_decomposition`. -/
lemma edgesAct_stab (i : Fin 30) : Nat.card {g : A5 // edgesAct g i = i} = 2 := by
  have h := card_mul_card_stab edgesAct i (fun j => edgesAct_transitive i j)
  rw [card_A5] at h
  omega

/-! ## The unconditional decompositions -/

/-- **Problem 4.12.5(a), unconditionally.** The representation of `A₅` on the space of complex
functions on the `12` vertices of the regular icosahedron decomposes as `1 ⊕ 3 ⊕ 3' ⊕ 5`. -/
theorem vertices_decomposition_icosahedral :
    ∃ (S : Fin 4 → Submodule ℂ (Fin 12 → ℂ))
      (hS : ∀ k, ∀ g : A5, ∀ v ∈ S k, permRep verticesAct g v ∈ S k),
      DirectSum.IsInternal S ∧
      (∀ k, IsIrredSub (permRep verticesAct) (S k)) ∧
      Module.finrank ℂ (S 0) = 1 ∧ Module.finrank ℂ (S 1) = 3 ∧
      Module.finrank ℂ (S 2) = 3 ∧ Module.finrank ℂ (S 3) = 5 ∧
      ∃ g : A5, subChar (permRep verticesAct) (S 1) (hS 1) g
        ≠ subChar (permRep verticesAct) (S 2) (hS 2) g :=
  vertices_decomposition verticesAct verticesAct_transitive verticesAct_stab

/-- **Problem 4.12.5(b), faces, unconditionally.** The representation of `A₅` on the space of
complex functions on the `20` faces decomposes as `1 ⊕ 3 ⊕ 3' ⊕ 4² ⊕ 5`. -/
theorem faces_decomposition_icosahedral :
    ∃ (S : Fin 6 → Submodule ℂ (Fin 20 → ℂ))
      (hS : ∀ k, ∀ g : A5, ∀ v ∈ S k, permRep facesAct g v ∈ S k),
      DirectSum.IsInternal S ∧
      (∀ k, IsIrredSub (permRep facesAct) (S k)) ∧
      Module.finrank ℂ (S 0) = 1 ∧ Module.finrank ℂ (S 1) = 3 ∧
      Module.finrank ℂ (S 2) = 3 ∧ Module.finrank ℂ (S 3) = 4 ∧
      Module.finrank ℂ (S 4) = 4 ∧ Module.finrank ℂ (S 5) = 5 ∧
      ∃ g : A5, subChar (permRep facesAct) (S 1) (hS 1) g
        ≠ subChar (permRep facesAct) (S 2) (hS 2) g :=
  faces_decomposition facesAct facesAct_transitive facesAct_stab

/-- **Problem 4.12.5(b), edges, unconditionally.** The representation of `A₅` on the space of
complex functions on the `30` edges decomposes as `1 ⊕ 3 ⊕ 3' ⊕ 4² ⊕ 5³`. -/
theorem edges_decomposition_icosahedral :
    ∃ (S : Fin 8 → Submodule ℂ (Fin 30 → ℂ))
      (hS : ∀ k, ∀ g : A5, ∀ v ∈ S k, permRep edgesAct g v ∈ S k),
      DirectSum.IsInternal S ∧
      (∀ k, IsIrredSub (permRep edgesAct) (S k)) ∧
      Module.finrank ℂ (S 0) = 1 ∧ Module.finrank ℂ (S 1) = 3 ∧
      Module.finrank ℂ (S 2) = 3 ∧ Module.finrank ℂ (S 3) = 4 ∧
      Module.finrank ℂ (S 4) = 4 ∧ Module.finrank ℂ (S 5) = 5 ∧
      Module.finrank ℂ (S 6) = 5 ∧ Module.finrank ℂ (S 7) = 5 ∧
      ∃ g : A5, subChar (permRep edgesAct) (S 1) (hS 1) g
        ≠ subChar (permRep edgesAct) (S 2) (hS 2) g :=
  edges_decomposition edgesAct edgesAct_transitive edgesAct_stab

end Icosahedron

end Etingof.Problem4_12_5
