import EtingofRepresentationTheory.Chapter6.Problem6_1_5_OrbitInjective
import EtingofRepresentationTheory.Chapter6.Problem6_1_5_DimBound
import EtingofRepresentationTheory.Chapter6.Problem6_1_1
import Mathlib

/-!
# Problem 6.1.5, Step 2(c): the strict dimension bound `dim W(m) < dim G(m)`

This file is part of the orbit-counting redirect for the Chapter 6 infinite-type
direction (directive #4777). It upgrades the **non-strict** bound
`dim W(m) ≤ dim G(m)` of `Problem6_1_5_DimBound` to the **strict** bound
`dim W(m) < dim G(m)` for nonzero `m` — the `−1` refinement that distinguishes
finite type (`q > 0`) from the borderline affine/extended Dynkin diagrams
(`q ≥ 0`), and the genuine remaining geometric crux of the Gabriel forward
direction.

## The `−1` (global scalars act trivially)

The single copy of global scalars `k*` embeds diagonally into
`repGroup k m = ∏ᵢ GL(Fin mᵢ) k` as `λ ↦ (fun i => λ • 1)` and acts **trivially**
on `repSpace m`: on the `i⟶j` block the action is `G_j · x · G_i⁻¹` and the
scalar `λ` cancels (`G_j ↦ λ G_j`, `G_i⁻¹ ↦ λ⁻¹ G_i⁻¹`). Concretely, the
*scaling* `k`-algebra automorphism of `K = k(GIdx m) = FractionRing (k[gₚᵩ])`
that sends each coordinate generator `g ↦ λ·g` (`scalingFieldEquiv`) fixes the
image of the orbit-map comorphism.

## The argument

Let `φ : k[WIdx m] → K` be the (injective) orbit-map comorphism composed into the
fraction field, with image fixed by every `scalingFieldEquiv lam`. Pick any single
group coordinate `g₀ = X t₀` (`GIdx m` is nonempty exactly when `m ≠ 0`). Then `g₀`
is **transcendental over the subfield generated by the image** of `φ`: a polynomial
relation with image-coefficients would, after applying `scalingFieldEquiv lam`
(which fixes the coefficients but sends `g₀ ↦ λ·g₀`), make every `λ·g₀`
(`λ ∈ k*`, infinitely many over an infinite field) a root — forcing the polynomial
to vanish. Adjoining the transcendental `g₀` to the algebraically-independent image
of `φ` keeps algebraic independence (`AlgebraicIndependent.option_iff_transcendental`),
so

`card (WIdx m) + 1 = trdeg k k[WIdx m ⊕ *] ≤ trdeg k K = card (GIdx m)`,

i.e. `card (WIdx m) < card (GIdx m)`.

## What this file provides

* `scalingAlgEquiv` / `scalingFieldEquiv`: the scaling automorphism of `k[τ]` and
  its lift to `K = FractionRing (k[τ])`.
* `Etingof.trdeg_fractionRing_mvPolynomial'`: the index-agnostic transcendence
  degree `trdeg k (FractionRing (k[τ])) = card τ`.
* `card_lt_of_injective_scalingInvariant`: the reusable abstract lemma — an
  injective `k[σ] → K` with scaling-invariant image forces `card σ < card τ`.
* `card_wIdx_lt_card_gIdx` and `repSpace_finrank_lt_repGroup_ambient_finrank`: the
  concrete strict bounds for `W(m)` / `G(m)`, the directly-consumable `hstrict`
  hook for `Etingof.isDynkinDiagram_of_strict_finrank` (`Problem6_1_5_TitsBridge`).
-/

open MvPolynomial Cardinal

namespace Etingof.Problem6_1_5

/-! ## The scaling automorphism -/

variable {k : Type} [Field k]

/-- The **scaling automorphism** of `k[τ]`: each coordinate generator scales,
`X t ↦ λ • X t`. -/
noncomputable def scalingAlgEquiv {τ : Type} (lam : kˣ) :
    MvPolynomial τ k ≃ₐ[k] MvPolynomial τ k :=
  AlgEquiv.ofAlgHom
    (aeval (fun t : τ => (lam : k) • X t))
    (aeval (fun t : τ => ((lam⁻¹ : kˣ) : k) • X t))
    (by
      apply MvPolynomial.algHom_ext; intro t
      simp only [AlgHom.comp_apply, aeval_X, map_smul, AlgHom.id_apply, smul_smul]
      rw [Units.inv_mul, one_smul])
    (by
      apply MvPolynomial.algHom_ext; intro t
      simp only [AlgHom.comp_apply, aeval_X, map_smul, AlgHom.id_apply, smul_smul]
      rw [Units.mul_inv, one_smul])

@[simp]
theorem scalingAlgEquiv_X {τ : Type} (lam : kˣ) (t : τ) :
    scalingAlgEquiv (k := k) lam (X t) = (lam : k) • X t := by
  rw [scalingAlgEquiv, AlgEquiv.ofAlgHom_apply, aeval_X]

/-- The lift of the scaling automorphism to `K = FractionRing (k[τ])`. -/
noncomputable def scalingFieldEquiv (τ : Type) (lam : kˣ) :
    FractionRing (MvPolynomial τ k) ≃ₐ[k] FractionRing (MvPolynomial τ k) :=
  IsFractionRing.algEquivOfAlgEquiv (scalingAlgEquiv (k := k) (τ := τ) lam)

@[simp]
theorem scalingFieldEquiv_g (τ : Type) (lam : kˣ) (t : τ) :
    scalingFieldEquiv (k := k) τ lam
        (algebraMap (MvPolynomial τ k) (FractionRing (MvPolynomial τ k)) (X t))
      = (lam : k) • algebraMap (MvPolynomial τ k) (FractionRing (MvPolynomial τ k)) (X t) := by
  rw [scalingFieldEquiv, IsFractionRing.algEquivOfAlgEquiv_algebraMap, scalingAlgEquiv_X]
  simp only [Algebra.smul_def, map_mul, ← IsScalarTower.algebraMap_apply]

end Etingof.Problem6_1_5

/-! ## Index-agnostic transcendence degree of `k(τ)` -/

namespace Etingof

open Cardinal

variable {k : Type} [Field k]

/-- The transcendence degree of `k(τ) = FractionRing (k[τ])` over `k` is `card τ`,
for any finite index type `τ`. The fraction field is algebraic over the polynomial
ring, so by the tower formula its transcendence degree equals that of `k[τ]`. This
is the index-agnostic version of `trdeg_fractionRing_mvPolynomial`. -/
theorem trdeg_fractionRing_mvPolynomial' (τ : Type) [Fintype τ] :
    Algebra.trdeg k (FractionRing (MvPolynomial τ k)) = (Fintype.card τ : Cardinal) := by
  haveI halg : Algebra.IsAlgebraic (MvPolynomial τ k)
      (FractionRing (MvPolynomial τ k)) :=
    IsLocalization.isAlgebraic _ (nonZeroDivisors (MvPolynomial τ k))
  have hz : Algebra.trdeg (MvPolynomial τ k)
      (FractionRing (MvPolynomial τ k)) = 0 := trdeg_eq_zero
  have htower := trdeg_add_eq k (MvPolynomial τ k)
      (A := FractionRing (MvPolynomial τ k))
  rw [hz, add_zero, MvPolynomial.trdeg_of_isDomain, mk_fintype, lift_natCast] at htower
  exact htower.symm

end Etingof

/-! ## The abstract strict-bound lemma -/

namespace Etingof.Problem6_1_5

open Cardinal

variable {k : Type} [Field k] [Infinite k]

/-- **The reusable strict-bound lemma.** Let `K = FractionRing (k[τ])` (`τ` finite,
with a distinguished generator index `t₀`). An injective `k`-algebra hom
`φ : k[σ] → K` (`σ` finite) whose image is invariant under every scaling
automorphism `scalingFieldEquiv τ lam` forces `card σ < card τ`.

This is the `−1` refinement: the distinguished generator `g₀ = X t₀` is
transcendental over the scaling-fixed image, so it can be adjoined while preserving
algebraic independence, giving `card σ + 1 ≤ trdeg k K = card τ`. -/
theorem card_lt_of_injective_scalingInvariant {σ τ : Type} [Fintype σ] [Fintype τ]
    (t₀ : τ)
    (φ : MvPolynomial σ k →ₐ[k] FractionRing (MvPolynomial τ k))
    (hφ : Function.Injective φ)
    (hfix : ∀ lam : kˣ, ∀ w : σ, scalingFieldEquiv τ lam (φ (X w)) = φ (X w)) :
    Fintype.card σ < Fintype.card τ := by
  sorry

end Etingof.Problem6_1_5
