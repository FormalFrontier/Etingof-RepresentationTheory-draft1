import Mathlib.GroupTheory.FreeAbelianGroup
import Mathlib.LinearAlgebra.TensorProduct.Basic

/-!
# Exercise 2.11.2: `V ⊗ W` as a quotient of the free abelian group `V • W`

The tensor product `V ⊗ W` (over a field `k`) can be equivalently defined as the quotient of the
free abelian group `V • W` generated by the symbols `v ⊗ w` (`v ∈ V`, `w ∈ W`) by the subgroup
generated by

* `(v₁ + v₂) ⊗ w - v₁ ⊗ w - v₂ ⊗ w`,
* `v ⊗ (w₁ + w₂) - v ⊗ w₁ - v ⊗ w₂`,
* `a·v ⊗ w - v ⊗ a·w`   (for `a ∈ k`).

We model `V • W` as `FreeAbelianGroup (V × W)` (the free abelian group on the set of pairs, whose
generator `of (v, w)` stands for the symbol `v ⊗ w`), form the relation subgroup, and record that
the resulting quotient is isomorphic, as an abelian group, to Mathlib's `V ⊗[k] W`.

Statement-only: the additive isomorphism is asserted (its construction/proof is deferred).
-/

namespace Etingof.Exercise2_11_2

open scoped TensorProduct

variable (k V W : Type*) [CommRing k] [AddCommGroup V] [Module k V] [AddCommGroup W] [Module k W]

/-- The defining relations of the tensor product, as a set of elements of the free abelian group
`V • W = FreeAbelianGroup (V × W)`: bi-additivity in each variable and `k`-balancing. -/
def relSet : Set (FreeAbelianGroup (V × W)) :=
  {x | (∃ v₁ v₂ w, x = FreeAbelianGroup.of (v₁ + v₂, w) - FreeAbelianGroup.of (v₁, w)
          - FreeAbelianGroup.of (v₂, w)) ∨
       (∃ v w₁ w₂, x = FreeAbelianGroup.of (v, w₁ + w₂) - FreeAbelianGroup.of (v, w₁)
          - FreeAbelianGroup.of (v, w₂)) ∨
       (∃ (a : k) (v : V) (w : W), x = FreeAbelianGroup.of (a • v, w)
          - FreeAbelianGroup.of (v, a • w))}

/-- The subgroup of `V • W` generated by the tensor-product relations. -/
def relSubgroup : AddSubgroup (FreeAbelianGroup (V × W)) :=
  AddSubgroup.closure (relSet k V W)

/-- The quotient of the free abelian group `V • W` by the tensor-product relations — the
"generators and relations" construction of `V ⊗ W`. -/
abbrev tensorQuot := FreeAbelianGroup (V × W) ⧸ relSubgroup k V W

/-- **Exercise 2.11.2.** The generators-and-relations construction of the tensor product agrees
with Mathlib's `V ⊗[k] W`: they are isomorphic as abelian groups. -/
theorem nonempty_addEquiv_tensorProduct :
    Nonempty (tensorQuot k V W ≃+ (V ⊗[k] W)) :=
  sorry

end Etingof.Exercise2_11_2
