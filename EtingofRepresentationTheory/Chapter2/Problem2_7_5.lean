import Mathlib
import EtingofRepresentationTheory.Chapter2.Proposition2_7_1_ii

/-!
# Problem 2.7.5: Center, ideals, and representations of the `q`-Weyl algebra

Let `q` be a nonzero complex number and let `A = A_q` be the `q`-Weyl algebra over `ℂ`
(the quantum torus generated by `x, x⁻¹, y, y⁻¹` with `yx = q·xy`). We use the concrete
realization `Etingof.qWeylAlgebra ℂ q` (a subalgebra of `End_ℂ M`, `M = (ℤ × ℤ) →₀ ℂ`) built
in Proposition 2.7.1(ii); its monomials are `xⁱyʲ = qMono (i, j)`, and `qMono_mem` shows each
monomial lies in `A`.

We render the book's *answers* as the statements (spec); proofs are deferred.

* **(a)** If `q` is **not** a root of unity, the center of `A` is trivial (just the scalars `ℂ`)
  and `A` is a simple ring (its only two-sided ideals are `0` and `A`). If `q` **is** a root of
  unity of order `n`, the center is the subalgebra generated by `xⁿ, x⁻ⁿ, yⁿ, y⁻ⁿ`.

* **(b)** `A` has a nonzero finite dimensional representation iff `q` is a root of unity. The
  obstruction (hint: use determinants) is that on any finite dimensional module `yx = q·xy`
  forces `det(ρ y)·det(ρ x) = q^{dim V}·det(ρ x)·det(ρ y)`, whence `q^{dim V} = 1`.

* **(c)** For `q` a root of unity of order `n`, every finite dimensional irreducible
  representation of `A` has dimension exactly `n`.
-/

namespace Etingof.Problem2_7_5

open Etingof

variable (q : ℂˣ)

/-! ## (a) Center and ideals -/

/-- **(a)** If `q` is not a root of unity, the center of the `q`-Weyl algebra is trivial: it
equals the scalar subalgebra `⊥` (the image of `ℂ`). -/
theorem center_eq_bot_of_not_isOfFinOrder (hq : ¬ IsOfFinOrder q) :
    Subalgebra.center ℂ (qWeylAlgebra ℂ q) = ⊥ :=
  sorry

/-- **(a)** If `q` is not a root of unity, the `q`-Weyl algebra is a simple ring: its only
two-sided ideals are `0` and the whole algebra. -/
theorem isSimpleRing_of_not_isOfFinOrder (hq : ¬ IsOfFinOrder q) :
    IsSimpleRing (qWeylAlgebra ℂ q) :=
  sorry

/-- **(a)** If `q` is a root of unity of order `n = orderOf q`, the center of the `q`-Weyl
algebra is the subalgebra generated by the powers `xⁿ = qMono (n, 0)`, `x⁻ⁿ = qMono (-n, 0)`,
`yⁿ = qMono (0, n)`, `y⁻ⁿ = qMono (0, -n)`. -/
theorem center_of_isOfFinOrder (hq : IsOfFinOrder q) :
    Subalgebra.center ℂ (qWeylAlgebra ℂ q) =
      Algebra.adjoin ℂ
        { (⟨qMono ℂ q ((orderOf q : ℤ), 0), qMono_mem ℂ q _⟩ : qWeylAlgebra ℂ q),
          ⟨qMono ℂ q (-(orderOf q : ℤ), 0), qMono_mem ℂ q _⟩,
          ⟨qMono ℂ q (0, (orderOf q : ℤ)), qMono_mem ℂ q _⟩,
          ⟨qMono ℂ q (0, -(orderOf q : ℤ)), qMono_mem ℂ q _⟩ } :=
  sorry

/-! ## (b) Existence of finite dimensional representations (determinant obstruction) -/

/-- **(b)** The determinant obstruction: on any finite dimensional representation `V` of the
`q`-Weyl algebra, `q^{dim V} = 1`. (Because `x, y` act invertibly and `yx = q·xy`, taking
determinants gives `det(ρ y)·det(ρ x) = q^{dim V}·det(ρ x)·det(ρ y)`.) -/
theorem q_pow_finrank_eq_one
    (V : Type*) [AddCommGroup V] [Module ℂ V] [Module (qWeylAlgebra ℂ q) V]
    [IsScalarTower ℂ (qWeylAlgebra ℂ q) V] [FiniteDimensional ℂ V] :
    (q : ℂ) ^ (Module.finrank ℂ V) = 1 :=
  sorry

/-- **(b)** Consequently, if the `q`-Weyl algebra has a *nonzero* finite dimensional
representation, then `q` is a root of unity. -/
theorem isOfFinOrder_of_nontrivial_finrep
    (V : Type*) [AddCommGroup V] [Module ℂ V] [Module (qWeylAlgebra ℂ q) V]
    [IsScalarTower ℂ (qWeylAlgebra ℂ q) V] [FiniteDimensional ℂ V] [Nontrivial V] :
    IsOfFinOrder q :=
  sorry

/-! ## (c) Finite dimensional irreducible representations -/

/-- **(c)** Every finite dimensional irreducible representation of the `q`-Weyl algebra has
dimension exactly `orderOf q` (which is forced to be nonzero, i.e. `q` is a root of unity, by
the existence of such a representation). -/
theorem finrank_irreducible_eq_orderOf
    (V : Type*) [AddCommGroup V] [Module ℂ V] [Module (qWeylAlgebra ℂ q) V]
    [IsScalarTower ℂ (qWeylAlgebra ℂ q) V] [FiniteDimensional ℂ V]
    [IsSimpleModule (qWeylAlgebra ℂ q) V] :
    Module.finrank ℂ V = orderOf q :=
  sorry

end Etingof.Problem2_7_5
