import Mathlib

/-!
# Problem 2.16.5: Irreducible representations of the quantum group `U_q(sl₂)`

Let `k` be an algebraically closed field of characteristic zero (here `ℂ`) and let `q ∈ k^×`
with `q ≠ ±1`. The **quantum enveloping algebra** `U_q(sl₂)` is the algebra generated by
`e, f, K, K⁻¹` with relations

  `K e K⁻¹ = q² e`,  `K f K⁻¹ = q⁻² f`,  `[e, f] = (K - K⁻¹) / (q - q⁻¹)`.

The exercise asks to classify the irreducible representations, treating separately the cases
of `q` a root of unity and `q` not a root of unity.

## Construction

We build `U_q(sl₂)` as `RingQuot (Rel q)`, the quotient of the free `ℂ`-algebra on four
generators `e, f, K, L` (`L` playing the role of `K⁻¹`) by the defining relations, cleared of
denominators so they are well-typed for every `q` (the coefficient `q - q⁻¹` is nonzero since
`q ≠ ±1`):

  `K L = 1`,  `L K = 1`,  `K e = q²·(e K)`,  `K f = q⁻²·(f K)`,
  `(q - q⁻¹)·(e f - f e) = K - L`.

The algebra and its generators are genuine (not sorried). The classification of irreducibles
is the deferred content; we record the core structural statement (existence of a highest
weight vector on any finite dimensional representation) as the spec.
-/

namespace Etingof.Problem2_16_5

/-- Generators of the free algebra: `0 ↦ e`, `1 ↦ f`, `2 ↦ K`, `3 ↦ L (= K⁻¹)`. -/
abbrev Gen := Fin 4

/-- The `e` generator in the free algebra. -/
noncomputable abbrev fe : FreeAlgebra ℂ Gen := FreeAlgebra.ι ℂ (0 : Fin 4)
/-- The `f` generator in the free algebra. -/
noncomputable abbrev ff : FreeAlgebra ℂ Gen := FreeAlgebra.ι ℂ (1 : Fin 4)
/-- The `K` generator in the free algebra. -/
noncomputable abbrev fK : FreeAlgebra ℂ Gen := FreeAlgebra.ι ℂ (2 : Fin 4)
/-- The `L = K⁻¹` generator in the free algebra. -/
noncomputable abbrev fL : FreeAlgebra ℂ Gen := FreeAlgebra.ι ℂ (3 : Fin 4)

/-- The defining relations of `U_q(sl₂)` (with denominators cleared). -/
inductive Rel (q : ℂˣ) : FreeAlgebra ℂ Gen → FreeAlgebra ℂ Gen → Prop
  | KL : Rel q (fK * fL) 1
  | LK : Rel q (fL * fK) 1
  | Ke : Rel q (fK * fe) (((q : ℂ) ^ 2) • (fe * fK))
  | Kf : Rel q (fK * ff) (((q : ℂ) ^ 2)⁻¹ • (ff * fK))
  | ef : Rel q (((q : ℂ) - (q : ℂ)⁻¹) • (fe * ff - ff * fe)) (fK - fL)

/-- The quantum group `U_q(sl₂)`. -/
noncomputable abbrev Uqsl2 (q : ℂˣ) : Type := RingQuot (Rel q)

/-- The canonical algebra map from the free algebra onto `U_q(sl₂)`. -/
noncomputable def mk (q : ℂˣ) : FreeAlgebra ℂ Gen →ₐ[ℂ] Uqsl2 q := RingQuot.mkAlgHom ℂ (Rel q)

/-- The generator `e` of `U_q(sl₂)`. -/
noncomputable def e (q : ℂˣ) : Uqsl2 q := mk q fe
/-- The generator `f` of `U_q(sl₂)`. -/
noncomputable def f (q : ℂˣ) : Uqsl2 q := mk q ff
/-- The generator `K` of `U_q(sl₂)`. -/
noncomputable def K (q : ℂˣ) : Uqsl2 q := mk q fK
/-- The generator `L = K⁻¹` of `U_q(sl₂)`. -/
noncomputable def L (q : ℂˣ) : Uqsl2 q := mk q fL

/-! ## The defining relations hold in `U_q(sl₂)` -/

@[simp] lemma KL_rel (q : ℂˣ) : K q * L q = 1 := by
  have h := RingQuot.mkAlgHom_rel ℂ (Rel.KL (q := q)); simp only [map_mul, map_one] at h; exact h

@[simp] lemma LK_rel (q : ℂˣ) : L q * K q = 1 := by
  have h := RingQuot.mkAlgHom_rel ℂ (Rel.LK (q := q)); simp only [map_mul, map_one] at h; exact h

/-- `K e = q²·(e K)`, i.e. `K e K⁻¹ = q² e`. -/
@[simp] lemma Ke_rel (q : ℂˣ) : K q * e q = ((q : ℂ) ^ 2) • (e q * K q) := by
  have h := RingQuot.mkAlgHom_rel ℂ (Rel.Ke (q := q)); simp only [map_mul, map_smul] at h; exact h

/-- `K f = q⁻²·(f K)`, i.e. `K f K⁻¹ = q⁻² f`. -/
@[simp] lemma Kf_rel (q : ℂˣ) : K q * f q = ((q : ℂ) ^ 2)⁻¹ • (f q * K q) := by
  have h := RingQuot.mkAlgHom_rel ℂ (Rel.Kf (q := q)); simp only [map_mul, map_smul] at h; exact h

/-- `(q - q⁻¹)·(e f - f e) = K - L`, the cleared-denominator form of `[e, f] = (K - K⁻¹)/(q - q⁻¹)`. -/
@[simp] lemma ef_rel (q : ℂˣ) :
    ((q : ℂ) - (q : ℂ)⁻¹) • (e q * f q - f q * e q) = K q - L q := by
  have h := RingQuot.mkAlgHom_rel ℂ (Rel.ef (q := q))
  simp only [map_smul, map_sub, map_mul] at h; exact h

/-! ## Classification of irreducible representations (spec) -/

/-- **Highest weight vector.** Every nonzero finite dimensional representation of `U_q(sl₂)`
contains a nonzero vector `v` that is annihilated by `e` and is an eigenvector of `K`
(`K • v = λ v`). This is the structural core of the classification of irreducible
representations; the full labelling of irreducibles (and the root-of-unity vs. non-root-of-unity
dichotomy for which highest weights occur and in which dimensions) is the deferred content. -/
theorem exists_highest_weight_vector (q : ℂˣ) (hq : q ≠ 1 ∧ q ≠ -1)
    (V : Type*) [AddCommGroup V] [Module ℂ V] [Module (Uqsl2 q) V]
    [IsScalarTower ℂ (Uqsl2 q) V] [FiniteDimensional ℂ V] [Nontrivial V] :
    ∃ (v : V) (lam : ℂ), v ≠ 0 ∧ e q • v = 0 ∧ K q • v = lam • v :=
  sorry

/-- **Non-root-of-unity case.** When `q` is not a root of unity, every finite dimensional
irreducible representation is determined up to isomorphism by its dimension together with a
sign `ε ∈ {±1}`: on a highest weight vector `v` of an `(n+1)`-dimensional irreducible, `K`
acts by `ε qⁿ`. We record the eigenvalue constraint on the highest weight. -/
theorem highest_weight_eigenvalue_of_not_isOfFinOrder (q : ℂˣ) (hq : ¬ IsOfFinOrder q)
    (V : Type*) [AddCommGroup V] [Module ℂ V] [Module (Uqsl2 q) V]
    [IsScalarTower ℂ (Uqsl2 q) V] [FiniteDimensional ℂ V] [IsSimpleModule (Uqsl2 q) V] :
    ∃ (v : V) (ε : ℂ), v ≠ 0 ∧ e q • v = 0 ∧ ε ^ 2 = 1 ∧
      K q • v = (ε * (q : ℂ) ^ (Module.finrank ℂ V - 1)) • v :=
  sorry

/-- **Root-of-unity case.** When `q` is a root of unity, the dimensions of the finite
dimensional irreducible representations are bounded (by `orderOf q`): they no longer occur in
every dimension, in contrast to the non-root-of-unity case. -/
theorem finrank_irreducible_le_of_isOfFinOrder (q : ℂˣ) (hq : IsOfFinOrder q)
    (V : Type*) [AddCommGroup V] [Module ℂ V] [Module (Uqsl2 q) V]
    [IsScalarTower ℂ (Uqsl2 q) V] [FiniteDimensional ℂ V] [IsSimpleModule (Uqsl2 q) V] :
    Module.finrank ℂ V ≤ orderOf q :=
  sorry

end Etingof.Problem2_16_5
