import Mathlib

/-!
# Problem 5.24.2: the invariant ring is generated by trace-of-word functions

**Problem 5.24.2.** Let `R_{k,N}` be the algebra of polynomials on the space of `k`-tuples of
complex `N × N` matrices `X₁, …, X_k`, invariant under simultaneous conjugation. An example of an
element of `R_{k,N}` is the function `T_w := Tr(w(X₁, …, X_k))`, where `w` is any finite word on a
`k`-letter alphabet. Show that `R_{k,N}` is generated by the elements `T_w`.

*Hint.* Consider invariant functions of degree `d_i` in each `X_i`, realize this space as
`⨂_i Sᵈ(V ⊗ V*)`, embed it into `(V ⊗ V*)^{⊗n} = End(V)^{⊗n}`, and apply Schur–Weyl duality.

## Formalization

The coordinate ring of the space of `k`-tuples of `N × N` complex matrices is the polynomial ring
`MvPoly := MvPolynomial (Fin k × Fin N × Fin N) ℂ`, one variable `(i, r, c)` for the `(r, c)` entry
of the `i`-th matrix. The generic `i`-th matrix `Xmat i` has these variables as entries.

* **Simultaneous conjugation.** An invertible matrix `g ∈ GLₙ(ℂ)` acts by the `ℂ`-algebra
  automorphism `conjAlgHom g` substituting each `Xmat i` by `g · Xmat i · g⁻¹` (i.e. variable
  `(i, r, c) ↦ (g Xᵢ g⁻¹)_{r c}`).
* **The invariant ring `R_{k,N}`** is `invariantSubalgebra`: the subalgebra of polynomials fixed by
  `conjAlgHom g` for every `g`, realized as the infimum of the equalizers of `conjAlgHom g` and the
  identity.
* **Trace-of-word functions.** For a word `w : List (Fin k)`, `traceWord w := Tr(w(X₁, …, X_k))` is
  the trace of the matrix product `∏_{i ∈ w} Xmat i`.

The claim: the invariant ring is generated as a `ℂ`-algebra by the `traceWord w`, i.e.
`Algebra.adjoin ℂ (Set.range traceWord) = invariantSubalgebra`.

Statement pass: the proof is left as `sorry`.
-/

noncomputable section

namespace Etingof

open scoped Classical

variable (k N : ℕ)

/-- The coordinate ring of `k`-tuples of `N × N` complex matrices: one variable `(i, r, c)` per
matrix entry. -/
abbrev MatrixTupleRing : Type := MvPolynomial (Fin k × Fin N × Fin N) ℂ

/-- The generic `i`-th matrix `Xᵢ`, whose `(r, c)` entry is the variable `(i, r, c)`. -/
noncomputable def genericMatrix (i : Fin k) :
    Matrix (Fin N) (Fin N) (MatrixTupleRing k N) :=
  fun r c => MvPolynomial.X (i, r, c)

/-- Simultaneous conjugation by `g ∈ GLₙ(ℂ)` as a `ℂ`-algebra automorphism of the coordinate ring:
it substitutes each generic matrix `Xᵢ` by `g · Xᵢ · g⁻¹`. -/
noncomputable def conjAlgHom (g : (Matrix (Fin N) (Fin N) ℂ)ˣ) :
    MatrixTupleRing k N →ₐ[ℂ] MatrixTupleRing k N :=
  MvPolynomial.aeval fun v : Fin k × Fin N × Fin N =>
    (((↑g : Matrix (Fin N) (Fin N) ℂ).map (algebraMap ℂ (MatrixTupleRing k N)))
        * genericMatrix k N v.1
        * ((↑g⁻¹ : Matrix (Fin N) (Fin N) ℂ).map (algebraMap ℂ (MatrixTupleRing k N))))
      v.2.1 v.2.2

/-- The invariant ring `R_{k,N}`: polynomials fixed by simultaneous conjugation by every
`g ∈ GLₙ(ℂ)`, as the infimum of the equalizers of `conjAlgHom g` and the identity. -/
noncomputable def invariantSubalgebra : Subalgebra ℂ (MatrixTupleRing k N) :=
  ⨅ g : (Matrix (Fin N) (Fin N) ℂ)ˣ,
    AlgHom.equalizer (conjAlgHom k N g) (AlgHom.id ℂ (MatrixTupleRing k N))

/-- The trace-of-word function `T_w = Tr(w(X₁, …, X_k))`: the trace of the matrix product of the
generic matrices indexed by the letters of the word `w`. -/
noncomputable def traceWord (w : List (Fin k)) : MatrixTupleRing k N :=
  Matrix.trace ((w.map (genericMatrix k N)).prod)

/-- Problem 5.24.2. The invariant ring `R_{k,N}` of polynomials on `k`-tuples of `N × N` matrices,
invariant under simultaneous conjugation, is generated as a `ℂ`-algebra by the trace-of-word
functions `T_w = Tr(w(X₁, …, X_k))`. -/
theorem invariantSubalgebra_eq_adjoin_traceWord :
    Algebra.adjoin ℂ (Set.range (traceWord k N)) = invariantSubalgebra k N := by
  sorry

end Etingof
